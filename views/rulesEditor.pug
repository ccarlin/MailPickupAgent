extends adminLayout

block css
    style.
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f5f5f5; color: #333; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; }
        h1 { margin-bottom: 8px; }
        .header-bar h1 { margin: 0; }
        .section { background: #fff; border: 1px solid #ddd; border-radius: 8px; margin-bottom: 20px; overflow: hidden; }
        .section-header { background: #f0f4f8; padding: 12px 16px 0px 16px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ddd; cursor: pointer; }
        .section-header h2 { font-size: 16px; margin: 0; }
        .section-header .count { font-size: 13px; color: #666; margin-left: 8px; }
        .section-header .actions { display: flex; gap: 8px; align-items: center; }
        .section-body { padding: 12px 16px; }
        .section-body.collapsed { display: none; }
        .subsection { margin-bottom: 16px; }
        .subsection:last-child { margin-bottom: 0; }
        .subsection-title { font-size: 14px; font-weight: 600; color: #444; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }
        .list { list-style: none; }
        .list-item { display: flex; justify-content: space-between; align-items: center; padding: 6px 8px; border-bottom: 1px solid #eee; font-size: 13px; font-family: 'Consolas', 'Courier New', monospace; }
        .list-item:last-child { border-bottom: none; }
        .list-item .value { flex: 1; word-break: break-all; padding-right: 12px; }
        .hit-count { color: #666; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 12px; margin-right: 12px; white-space: nowrap; }
        .list-item .item-actions { display: flex; gap: 4px; flex-shrink: 0; }
        .list-item:hover { background: #f8f9fa; }
        .combo-grid { width: 100%; border-collapse: collapse; font-size: 13px; }
        .combo-grid th { background: #f0f4f8; padding: 8px; text-align: left; font-weight: 600; border-bottom: 2px solid #ddd; }
        .combo-grid td { padding: 6px 8px; border-bottom: 1px solid #eee; font-family: 'Consolas', 'Courier New', monospace; }
        .combo-grid tr:hover td { background: #f8f9fa; }
        .combo-grid .cell-actions { display: flex; gap: 4px; }
        .empty-state { color: #999; font-style: italic; padding: 12px 0; font-size: 13px; text-align: center; }
        .inline-form { display: flex; gap: 8px; padding: 6px 0; flex-wrap: wrap; align-items: center; }
        .inline-form input, .inline-form select, .inline-form textarea { padding: 6px 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px; font-family: 'Consolas', 'Courier New', monospace; }
        .inline-form input:focus, .inline-form select:focus, .inline-form textarea:focus { outline: none; border-color: #1a73e8; box-shadow: 0 0 0 2px rgba(26,115,232,0.2); }
        .inline-form .btn { padding: 6px 12px; font-size: 13px; }

        .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 999; }
        .modal { background: #fff; border-radius: 8px; padding: 24px; min-width: 400px; max-width: 1000px; max-height: 80vh; overflow-y: auto; }
        .modal h3 { margin-bottom: 16px; }
        .modal-fields { display: grid; gap: 16px; }
        .modal-fields.single-column { grid-template-columns: 1fr; }
        .modal-fields.two-column { grid-template-columns: 1fr 1fr; }
        .modal .field { margin-bottom: 0; }
        .modal .field label { display: block; font-weight: 600; font-size: 13px; margin-bottom: 4px; color: #555; }
        .modal .field input, .modal .field select, .modal .field textarea { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px; font-family: 'Consolas', 'Courier New', monospace; }
        .modal .field textarea { min-height: 60px; resize: vertical; }
        .modal .field.full-width { grid-column: 1 / -1; }
        .modal .modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
        .toggle-icon { font-size: 12px; margin-right: 6px; }
    link(id="favicon" rel="icon" href="/img/MailPickupAgent.png" type="image/png")
    
block scripts
    script(src="https://cdn.jsdelivr.net/npm/jquery@4.0.0/dist/jquery.min.js")    
    script.
        let rulesData = null;
        let ruleHits = {};
        let collapsedSections = { whitelist: true, blacklist: true, allowedTLDs: true, scoredRules: true };
        let collapsedSubsections = { 'whitelist.senders': true, 'whitelist.ipRanges': true, 'blacklist.senders': true, 'blacklist.ipRanges': true, 'blacklist.countries': true, 'blacklist.combos': true, 'scoredRules.keywordFilters': true, 'allowedTLDs.allowedTLDs': true };

        function showToast(message, type) {
            const existing = document.querySelector('.toast');
            if (existing) existing.remove();
            const toast = document.createElement('div');
            toast.className = 'toast ' + type;
            toast.textContent = message;
            document.body.appendChild(toast);
            requestAnimationFrame(() => toast.classList.add('show'));
            setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); }, 2500);
        }

        function createButton(text, className, onClick) {
            const btn = document.createElement('button');
            btn.className = 'btn ' + className;
            btn.textContent = text;
            btn.addEventListener('click', onClick);
            return btn;
        }

        function confirmDelete(name) {
            return confirm('Delete "' + name + '"?');
        }

        function ruleKey(parent, key, rule) {
            return (parent ? parent + '.' : '') + key + ':' + (typeof rule === 'string' ? rule : JSON.stringify(rule));
        }

        function hitCount(parent, key, rule) {
            return ruleHits[ruleKey(parent, key, rule)] || 0;
        }

        // --- Modal helpers ---
        function showModal(title, fields, onSave, twoColumn, extraButtons) {
            const overlay = document.createElement('div');
            overlay.className = 'modal-overlay';

            const modal = document.createElement('div');
            modal.className = 'modal';
            const columnClass = twoColumn ? 'two-column' : 'single-column';
            let html = '<h3>' + title + '</h3><div class="modal-fields ' + columnClass + '">';
            fields.forEach(f => {
                const fullWidthClass = f.fullWidth ? ' full-width' : '';
                html += '<div class="field' + fullWidthClass + '"><label>' + f.label + '</label>';
                if (f.type === 'textarea') {
                html += '<textarea name="' + f.name + '">' + (f.value || '') + '</textarea>';
                } else if (f.type === 'select') {
                html += '<select name="' + f.name + '">';
                (f.options || []).forEach(o => {
                    html += '<option value="' + o.value + '"' + (o.value === f.value ? ' selected' : '') + '>' + o.label + '</option>';
                });
                html += '</select>';
                } else {
                html += '<input type="' + (f.type || 'text') + '" name="' + f.name + '" value="' + (f.value || '') + '" placeholder="' + (f.placeholder || '') + '">';
                }
                html += '</div>';
            });
            html += '</div><div class="modal-actions">';
            (extraButtons || []).forEach(b => {
                html += '<button class="btn ' + b.className + '" id="' + b.id + '">' + b.text + '</button>';
            });
            html += '<button class="btn btn-outline" id="modalCancelBtn">Cancel</button><button class="btn btn-primary" id="modalSaveBtn">Save</button></div>';
            modal.innerHTML = html;
            overlay.appendChild(modal);
            document.body.appendChild(overlay);

            modal.querySelector('#modalCancelBtn').addEventListener('click', () => overlay.remove());
            modal.querySelector('#modalSaveBtn').addEventListener('click', () => {
                const values = {};
                fields.forEach(f => {
                const el = modal.querySelector('[name="' + f.name + '"]');
                values[f.name] = el ? el.value : '';
                });
                onSave(values);
                overlay.remove();
            });
            (extraButtons || []).forEach(b => {
                const btn = modal.querySelector('#' + b.id);
                if (btn) btn.addEventListener('click', (e) => b.onClick(e, modal, fields, overlay));
            });
            modal.querySelector('input, textarea, select')?.focus();
        }

        async function aiGenerateFilter(description) {
            if (!description.trim()) { showToast('Please enter a description', 'error'); return null; }
            try {
                const resp = await fetch('/rulesEditor/api/rules/generate-keyword-filter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ description: description.trim() })
                });
                if (!resp.ok) {
                const err = await resp.json();
                throw new Error(err.message || 'Generation failed');
                }
                return await resp.json();
            } catch (error) {
                showToast('AI generation failed: ' + error.message, 'error');
                return null;
            }
        }

        function fillModalFields(modal, values) {
            Object.keys(values).forEach(key => {
                const el = modal.querySelector('[name="' + key + '"]');
                if (el) {
                if (el.tagName === 'SELECT') {
                    el.value = values[key];
                } else {
                    el.value = values[key];
                }
                }
            });
        }

        function showAiPromptModal(onResult) {
            const promptOverlay = document.createElement('div');
            promptOverlay.className = 'modal-overlay';

            promptOverlay.innerHTML = '<div class="modal" style="min-width:500px;"><h3>Generate Keyword Filter with AI</h3><div class="modal-fields single-column"><div class="field full-width"><label>Describe the rule you want to create</label><textarea id="aiPromptText" rows="4" style="width:100%;padding:8px;border:1px solid #ccc;border-radius:4px;font-size:13px;font-family:Consolas,Courier New,monospace;" placeholder="e.g. Block emails mentioning free crypto giveaways in the subject with score 8"></textarea></div></div><div class="modal-actions"><button class="btn btn-outline" id="aiPromptCancelBtn">Cancel</button><button class="btn btn-primary" id="aiPromptGenerateBtn">Generate</button></div></div>';
            document.body.appendChild(promptOverlay);

            promptOverlay.querySelector('#aiPromptCancelBtn').addEventListener('click', () => promptOverlay.remove());
            promptOverlay.querySelector('#aiPromptGenerateBtn').addEventListener('click', async () => {
                const desc = promptOverlay.querySelector('#aiPromptText').value;
                if (!desc.trim()) { showToast('Please describe the rule', 'error'); return; }
                const genBtn = promptOverlay.querySelector('#aiPromptGenerateBtn');
                genBtn.disabled = true;
                genBtn.textContent = 'Generating...';
                const result = await aiGenerateFilter(desc);
                genBtn.disabled = false;
                genBtn.textContent = 'Generate';
                if (result) {
                promptOverlay.remove();
                onResult(result);
                }
            });
            promptOverlay.querySelector('#aiPromptText').focus();
        }

        function ensureRulesStructure() {
            if (!rulesData || typeof rulesData !== 'object') {
                rulesData = {};
            }

            if (!rulesData.whitelist || typeof rulesData.whitelist !== 'object') {
                rulesData.whitelist = {};
            }
            if (!Array.isArray(rulesData.whitelist.senders)) rulesData.whitelist.senders = [];
            if (!Array.isArray(rulesData.whitelist.ipRanges)) rulesData.whitelist.ipRanges = [];

            if (!rulesData.blacklist || typeof rulesData.blacklist !== 'object') {
                rulesData.blacklist = {};
            }
            if (!Array.isArray(rulesData.blacklist.senders)) rulesData.blacklist.senders = [];
            if (!Array.isArray(rulesData.blacklist.ipRanges)) rulesData.blacklist.ipRanges = [];
            if (!Array.isArray(rulesData.blacklist.countries)) rulesData.blacklist.countries = [];
            if (!Array.isArray(rulesData.blacklist.combos)) rulesData.blacklist.combos = [];
            if (!Array.isArray(rulesData.blacklist.keywordFilters)) rulesData.blacklist.keywordFilters = [];

            if (!Array.isArray(rulesData.allowedTLDs)) rulesData.allowedTLDs = [];
            return rulesData;
        }

        function getRuleArray(parent, key) {
            ensureRulesStructure();
            if (parent) {
                if (!rulesData[parent] || typeof rulesData[parent] !== 'object') {
                    rulesData[parent] = {};
                }
                if (!Array.isArray(rulesData[parent][key])) {
                    rulesData[parent][key] = [];
                }
                return rulesData[parent][key];
            }
            if (!Array.isArray(rulesData[key])) {
                rulesData[key] = [];
            }
            return rulesData[key];
        }

        // --- Render sections ---
        function renderAllSections() {
            const container = document.getElementById('sectionsContainer');
            container.innerHTML = '';

            if (!rulesData) return;
            ensureRulesStructure();

            renderSection(container, 'Whitelist', 'whitelist', [
                { key: 'senders', label: 'Senders', type: 'string-array', parent: 'whitelist' },
                { key: 'ipRanges', label: 'IP Ranges', type: 'string-array', parent: 'whitelist' }
            ]);

            renderSection(container, 'Blacklist', 'blacklist', [
                { key: 'senders', label: 'Senders', type: 'string-array', parent: 'blacklist' },
                { key: 'ipRanges', label: 'IP Ranges', type: 'string-array', parent: 'blacklist' },
                { key: 'countries', label: 'Countries', type: 'string-array', parent: 'blacklist' },
                { key: 'combos', label: 'Combos', type: 'combos', parent: 'blacklist' }
            ]);

            renderSection(container, 'Scored Rules', 'scoredRules', [
                { key: 'keywordFilters', label: 'Keyword Filters', type: 'keywordFilters', parent: 'blacklist' }
            ]);

            renderSection(container, 'Allowed TLDs', 'allowedTLDs', [
                { key: 'allowedTLDs', label: 'TLDs', type: 'string-array', parent: null }
            ]);
        }

        function renderSection(container, title, sectionKey, subsections) {
            const section = document.createElement('div');
            section.className = 'section';

            const isCollapsed = collapsedSections[sectionKey];
            let totalCount = 0;
            subsections.forEach(ss => {
                const arr = ss.parent ? (rulesData[ss.parent]?.[ss.key]) : rulesData[ss.key];
                if (Array.isArray(arr)) totalCount += arr.length;
            });

            const header = document.createElement('div');
            header.className = 'section-header';
            header.innerHTML = '<h2><span class="toggle-icon">' + (isCollapsed ? '&#9654;' : '&#9660;') + '</span>' + title + ' <span class="count">(' + totalCount + ' entries)</span></h2>';
            header.addEventListener('click', (e) => {
                if (e.target.closest('.actions')) return;
                collapsedSections[sectionKey] = !collapsedSections[sectionKey];
                renderAllSections();
            });

            const body = document.createElement('div');
            body.className = 'section-body' + (isCollapsed ? ' collapsed' : '');

            subsections.forEach(ss => {
                const subDiv = document.createElement('div');
                subDiv.className = 'subsection';
                const subKey = (ss.parent ? ss.parent + '.' : '') + ss.key;
                const arr = ss.parent ? (rulesData[ss.parent]?.[ss.key]) : rulesData[ss.key];
                const count = Array.isArray(arr) ? arr.length : 0;
                const subCollapsed = collapsedSubsections[subKey];

                const subTitle = document.createElement('div');
                subTitle.className = 'subsection-title';
                subTitle.style.cursor = 'pointer';
                subTitle.innerHTML = '<span><span class="toggle-icon">' + (subCollapsed ? '&#9654;' : '&#9660;') + '</span>' + ss.label + ' (' + count + ')</span>';

                const addBtn = createButton('+ Add', 'btn-success btn-sm', (e) => {
                e.stopPropagation();
                if (ss.type === 'combos') addComboItem(ss.parent, ss.key);
                else if (ss.type === 'keywordFilters') addKeywordFilter(ss.parent, ss.key);
                else addStringItem(ss.parent, ss.key);
                });
                const actionsDiv = document.createElement('div');
                actionsDiv.appendChild(addBtn);
                subTitle.appendChild(actionsDiv);

                subTitle.addEventListener('click', (e) => {
                if (e.target.closest('.btn')) return;
                collapsedSubsections[subKey] = !collapsedSubsections[subKey];
                renderAllSections();
                });

                subDiv.appendChild(subTitle);

                if (!subCollapsed) {
                if (!Array.isArray(arr) || arr.length === 0) {
                    const empty = document.createElement('div');
                    empty.className = 'empty-state';
                    empty.textContent = 'No entries';
                    subDiv.appendChild(empty);
                } else {
                    if (ss.type === 'combos') {
                    subDiv.appendChild(renderComboList(arr, ss.parent, ss.key));
                    } else if (ss.type === 'keywordFilters') {
                    subDiv.appendChild(renderKeywordFilterList(arr, ss.parent, ss.key));
                    } else {
                    subDiv.appendChild(renderStringList(arr, ss.parent, ss.key));
                    }
                }
                }

                body.appendChild(subDiv);
            });

            section.appendChild(header);
            section.appendChild(body);
            container.appendChild(section);
        }

        // --- String array rendering ---
        function renderStringList(arr, parent, key) {
            const list = document.createElement('ul');
            list.className = 'list';
            arr.forEach((item, index) => {
                const li = document.createElement('li');
                li.className = 'list-item';
                const valSpan = document.createElement('span');
                valSpan.className = 'value';
                valSpan.textContent = item;
                li.appendChild(valSpan);

                const hits = document.createElement('span');
                hits.className = 'hit-count';
                hits.textContent = hitCount(parent, key, item) + ' hits';
                li.appendChild(hits);

                const actions = document.createElement('div');
                actions.className = 'item-actions';

                const editBtn = createButton('Edit', 'btn-outline btn-sm', () => {
                editStringItem(parent, key, index, item);
                });
                const delBtn = createButton('Del', 'btn-danger btn-sm', () => {
                if (confirmDelete(item)) {
                    arr.splice(index, 1);
                    renderAllSections();
                    markUnsaved();
                }
                });
                actions.appendChild(editBtn);
                actions.appendChild(delBtn);
                li.appendChild(actions);
                list.appendChild(li);
            });
            return list;
        }

        function addStringItem(parent, key) {
            const arr = getRuleArray(parent, key);
            const label = key.charAt(0).toUpperCase() + key.slice(1);
            showModal('Add ' + label.slice(0, -1), [
                { name: 'value', label: 'Value', type: 'text', value: '', placeholder: 'Enter value' }
            ], (values) => {
                if (!values.value.trim()) return;
                arr.push(values.value.trim());
                renderAllSections();
                markUnsaved();
                showToast('Added successfully', 'success');
            });
        }

        function editStringItem(parent, key, index, currentValue) {
            const arr = getRuleArray(parent, key);
            const label = key.charAt(0).toUpperCase() + key.slice(1);
            showModal('Edit ' + label.slice(0, -1), [
                { name: 'value', label: 'Value', type: 'text', value: currentValue, placeholder: 'Enter value' }
            ], (values) => {
                if (!values.value.trim()) return;
                arr[index] = values.value.trim();
                renderAllSections();
                markUnsaved();
                showToast('Updated successfully', 'success');
            });
        }

        // --- Combo rendering ---
        function renderComboList(arr, parent, key) {
            const table = document.createElement('table');
            table.className = 'combo-grid';
            const thead = document.createElement('thead');
            thead.innerHTML = '<tr><th>Recipient</th><th>Sender</th><th>IP Address</th><th>Hits</th><th></th></tr>';
            table.appendChild(thead);
            const tbody = document.createElement('tbody');
            arr.forEach((item, index) => {
                const tr = document.createElement('tr');
                tr.innerHTML = '<td>' + (item.recipient || '') + '</td><td>' + (item.sender || '') + '</td><td>' + (item.ipAddress || '') + '</td><td>' + hitCount(parent, key, item) + '</td>';
                const tdActions = document.createElement('td');
                tdActions.className = 'cell-actions';
                const editBtn = createButton('Edit', 'btn-outline btn-sm', () => editComboItem(parent, key, index, item));
                const delBtn = createButton('Del', 'btn-danger btn-sm', () => {
                if (confirmDelete(JSON.stringify(item))) {
                    arr.splice(index, 1);
                    renderAllSections();
                    markUnsaved();
                }
                });
                tdActions.appendChild(editBtn);
                tdActions.appendChild(delBtn);
                tr.appendChild(tdActions);
                tbody.appendChild(tr);
            });
            table.appendChild(tbody);
            return table;
        }

        function addComboItem(parent, key) {
            showModal('Add Combo', [
                { name: 'recipient', label: 'Recipient', type: 'text', value: '', placeholder: 'e.g. admin, postmaster, or empty for all' },
                { name: 'sender', label: 'Sender', type: 'text', value: '', placeholder: 'e.g. example.com (leave empty if using IP)' },
                { name: 'ipAddress', label: 'IP Address', type: 'text', value: '', placeholder: 'e.g. 10.0.0.0/8 (leave empty if using Sender)' }
            ], (values) => {
                const obj = {};
                if (values.recipient.trim()) obj.recipient = values.recipient.trim();
                if (values.sender.trim()) obj.sender = values.sender.trim();
                if (values.ipAddress.trim()) obj.ipAddress = values.ipAddress.trim();
                if (!obj.recipient && (!obj.sender && !obj.ipAddress)) { showToast('Need at least recipient or sender/IP', 'error'); return; }
                getRuleArray(parent, key).push(obj);
                renderAllSections();
                markUnsaved();
                showToast('Combo added', 'success');
            });
        }

        function editComboItem(parent, key, index, item) {
            showModal('Edit Combo', [
                { name: 'recipient', label: 'Recipient', type: 'text', value: item.recipient || '', placeholder: 'e.g. admin' },
                { name: 'sender', label: 'Sender', type: 'text', value: item.sender || '', placeholder: 'e.g. example.com' },
                { name: 'ipAddress', label: 'IP Address', type: 'text', value: item.ipAddress || '', placeholder: 'e.g. 10.0.0.0/8' }
            ], (values) => {
                const arr = getRuleArray(parent, key);
                const obj = {};
                if (values.recipient.trim()) obj.recipient = values.recipient.trim();
                if (values.sender.trim()) obj.sender = values.sender.trim();
                if (values.ipAddress.trim()) obj.ipAddress = values.ipAddress.trim();
                arr[index] = obj;
                renderAllSections();
                markUnsaved();
                showToast('Combo updated', 'success');
            });
        }

        // --- Keyword filter rendering ---
        function renderKeywordFilterList(arr, parent, key) {
            const table = document.createElement('table');
            table.className = 'combo-grid';
            const thead = document.createElement('thead');
            thead.innerHTML = '<tr><th>Name</th><th>Recipient</th><th>Expression</th><th>Score</th><th>Scope</th><th>ExprType</th><th>MatchType</th><th>Case</th><th>Comment</th><th>Hits</th><th></th></tr>';
            table.appendChild(thead);
            const tbody = document.createElement('tbody');
            arr.forEach((item, index) => {
                const tr = document.createElement('tr');
                tr.innerHTML = '<td>' + (item.FilterName || '') + '</td><td>' + (item.Recipient || '') + '</td><td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;">' + (item.FilterExpression || '') + '</td><td>' + (item.Score || '') + '</td><td>' + scopeLabel(item.SearchScope) + '</td><td>' + expTypeLabel(item.FilterExpressionType) + '</td><td>' + matchTypeLabel(item.FilterMatchType) + '</td><td>' + (String(item.FilterCaseSensitive || '') === '1' ? 'Yes' : 'No') + '</td><td>' + (item.Comment || '') + '</td><td>' + hitCount(parent, key, item) + '</td>';
                const tdActions = document.createElement('td');
                tdActions.className = 'cell-actions';
                const editBtn = createButton('Edit', 'btn-outline btn-sm', () => editKeywordFilter(parent, key, index, item));
                const delBtn = createButton('Del', 'btn-danger btn-sm', () => {
                if (confirmDelete(item.FilterName || 'filter')) {
                    arr.splice(index, 1);
                    renderAllSections();
                    markUnsaved();
                }
                });
                tdActions.appendChild(editBtn);
                tdActions.appendChild(delBtn);
                tr.appendChild(tdActions);
                tbody.appendChild(tr);
            });
            table.appendChild(tbody);
            return table;
        }

        function scopeLabel(scope) {
            const map = { '1': 'Body', '2': 'Subject', '3': 'Full', '4': 'Headers', '5': 'Sender' };
            return map[scope] || scope || 'Unknown';
        }

        function expTypeLabel(t) {
            return t === '1' ? 'Regex' : t === '0' ? 'Text' : t || '?';
        }

        function matchTypeLabel(t) {
            const map = { '0': 'Any', '1': 'Starts', '2': 'Ends', '3': 'Word' };
            return map[t] || t || 'Any';
        }

        function addKeywordFilter(parent, key) {
            showModal('Add Keyword Filter', [
                { name: 'FilterName', label: 'Filter Name', type: 'text', value: '', placeholder: 'e.g. MY_FILTER', fullWidth: true },
                { name: 'FilterExpression', label: 'Expression', type: 'textarea', value: '', placeholder: 'Regex or plain text', fullWidth: true },
                { name: 'Recipient', label: 'Recipient', type: 'text', value: '', placeholder: 'admin (empty for all)' },
                { name: 'Score', label: 'Score', type: 'number', value: '1', placeholder: 'Numeric score' },
                { name: 'SearchScope', label: 'Search Scope', type: 'select', value: '1', options: [{ value: '1', label: 'Body' }, { value: '2', label: 'Subject' }, { value: '3', label: 'Full' }, { value: '4', label: 'Headers' }, { value: '5', label: 'Sender' }] },
                { name: 'FilterExpressionType', label: 'Expression Type', type: 'select', value: '1', options: [{ value: '0', label: 'Simple (text match)' }, { value: '1', label: 'Complex (regex)' }] },
                { name: 'FilterMatchType', label: 'Match Type', type: 'select', value: '0', options: [{ value: '0', label: 'Any match' }, { value: '1', label: 'Starts with' }, { value: '2', label: 'Ends with' }, { value: '3', label: 'Whole word' }] },
                { name: 'FilterCaseSensitive', label: 'Case Sensitive', type: 'select', value: '0', options: [{ value: '0', label: 'No' }, { value: '1', label: 'Yes' }] },
                { name: 'Comment', label: 'Comment', type: 'text', value: '', placeholder: 'Optional comment', fullWidth: true }
            ], (values) => {
                if (!values.FilterName.trim()) { showToast('Filter name is required', 'error'); return; }
                if (!values.FilterExpression.trim()) { showToast('Expression is required', 'error'); return; }
                const filter = {
                FilterName: values.FilterName.trim(),
                SearchScope: values.SearchScope,
                FilterExpression: values.FilterExpression,
                FilterExpressionType: values.FilterExpressionType,
                FilterMatchType: values.FilterMatchType,
                FilterCaseSensitive: values.FilterCaseSensitive,
                Score: values.Score
                };
                if (values.Recipient.trim()) filter.Recipient = values.Recipient.trim().toLowerCase();
                if (values.Comment.trim()) filter.Comment = values.Comment.trim();
                getRuleArray(parent, key).push(filter);
                renderAllSections();
                markUnsaved();
                showToast('Filter added', 'success');
            }, true, [
                { text: 'AI Generate', className: 'btn-info btn-sm', id: 'modalAiBtn', onClick: (e, modal, fields, overlay) => {
                showAiPromptModal((result) => {
                    fillModalFields(modal, result);
                });
                } }
            ]);
        }

        function editKeywordFilter(parent, key, index, item) {
            showModal('Edit Keyword Filter', [
                { name: 'FilterName', label: 'Filter Name', type: 'text', value: item.FilterName || '', placeholder: 'e.g. MY_FILTER', fullWidth: true },
                { name: 'FilterExpression', label: 'Expression', type: 'textarea', value: item.FilterExpression || '', placeholder: 'Regex or plain text', fullWidth: true },
                { name: 'Recipient', label: 'Recipient', type: 'text', value: item.Recipient || '', placeholder: 'admin (empty for all)' },
                { name: 'Score', label: 'Score', type: 'number', value: item.Score || '1', placeholder: 'Numeric score' },
                { name: 'SearchScope', label: 'Search Scope', type: 'select', value: item.SearchScope || '1', options: [{ value: '1', label: 'Body' }, { value: '2', label: 'Subject' }, { value: '3', label: 'Full' }, { value: '4', label: 'Headers' }, { value: '5', label: 'Sender' }] },
                { name: 'FilterExpressionType', label: 'Expression Type', type: 'select', value: item.FilterExpressionType || '1', options: [{ value: '0', label: 'Simple (text match)' }, { value: '1', label: 'Complex (regex)' }] },
                { name: 'FilterMatchType', label: 'Match Type', type: 'select', value: item.FilterMatchType || '0', options: [{ value: '0', label: 'Any match' }, { value: '1', label: 'Starts with' }, { value: '2', label: 'Ends with' }, { value: '3', label: 'Whole word' }] },
                { name: 'FilterCaseSensitive', label: 'Case Sensitive', type: 'select', value: item.FilterCaseSensitive || '0', options: [{ value: '0', label: 'No' }, { value: '1', label: 'Yes' }] },
                { name: 'Comment', label: 'Comment', type: 'text', value: item.Comment || '', placeholder: 'Optional comment', fullWidth: true }
            ], (values) => {
                if (!values.FilterName.trim()) { showToast('Filter name is required', 'error'); return; }
                if (!values.FilterExpression.trim()) { showToast('Expression is required', 'error'); return; }
                const arr = getRuleArray(parent, key);
                arr[index] = {
                FilterName: values.FilterName.trim(),
                SearchScope: values.SearchScope,
                FilterExpression: values.FilterExpression,
                FilterExpressionType: values.FilterExpressionType,
                FilterMatchType: values.FilterMatchType,
                FilterCaseSensitive: values.FilterCaseSensitive,
                Score: values.Score
                };
                if (values.Recipient.trim()) arr[index].Recipient = values.Recipient.trim().toLowerCase();
                if (values.Comment.trim()) arr[index].Comment = values.Comment.trim();
                renderAllSections();
                markUnsaved();
                showToast('Filter updated', 'success');
            }, true, [
                { text: 'AI Generate', className: 'btn-info btn-sm', id: 'modalAiBtn', onClick: (e, modal, fields, overlay) => {
                showAiPromptModal((result) => {
                    const updatedFields = fields.map(f => {
                    const val = result[f.name] !== undefined ? result[f.name] : item[f.name] || '';
                    return { ...f, value: val };
                    });
                    overlay.remove();
                    editKeywordFilter(parent, key, index, result);
                });
                } }
            ]);
        }

        // --- Save / Load ---
        let unsaved = false;

        function markUnsaved() {
            unsaved = true;
            document.getElementById('lastSaved').textContent = '(unsaved changes)';
        }

        async function fetchRules() {
            try {
                const response = await fetch('/rulesEditor/api/rules');
                if (!response.ok) throw new Error('Failed to fetch rules');
                rulesData = await response.json();
                ensureRulesStructure();
                const hitsResponse = await fetch('/rulesEditor/api/rule-hits');
                if (!hitsResponse.ok) throw new Error('Failed to fetch rule hits');
                ruleHits = await hitsResponse.json();
                renderAllSections();
                document.getElementById('lastSaved').textContent = 'Loaded';
            } catch (error) {
                console.error('Error fetching rules:', error);
                showToast('Could not load rules', 'error');
            }
        }

        async function saveRules() {
            try {
                const response = await fetch('/rulesEditor/api/rules/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ rules: JSON.stringify(rulesData) })
                });
                if (!response.ok) throw new Error('Save failed');
                unsaved = false;
                document.getElementById('lastSaved').textContent = 'Saved at ' + new Date().toLocaleTimeString();
                showToast('Rules saved successfully!', 'success');
            } catch (error) {
                console.error('Error saving rules:', error);
                showToast('Failed to save rules', 'error');
            }
        }

        $(document).ready(function ()
        {     
            document.getElementById('saveButton').addEventListener('click', saveRules);

            window.addEventListener('beforeunload', (e) => {
                if (unsaved) { e.preventDefault(); e.returnValue = ''; }
            });

            fetchRules();

            const hb = document.querySelector('.header-bar');
            const scroller = document.querySelector('.right-column');
            if (hb && scroller) {
                scroller.addEventListener('scroll', () => hb.classList.toggle('scrolled', scroller.scrollTop > 0));
            }
        });

block content
    .container
      .header-bar
        h1 Manage Rules
        div
          span#lastSaved(style='font-size:13px;color:#888;margin-right:12px;')
          button#saveButton.btn.btn-primary Save Changes

      #sectionsContainer
