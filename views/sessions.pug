extends adminLayout

block css
    link(href="https://cdn.jsdelivr.net/npm/gridjs/dist/theme/mermaid.min.css" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet")
    link(id="favicon" rel="icon" href="/img/MailPickupAgent.png" type="image/png" sizes="16x16")
    style.
        .badge-current {
            display: inline-block;
            padding: 2px 8px;
            font-size: 11px;
            font-weight: 600;
            background: #dbeafe;
            color: #1d4ed8;
            border-radius: 10px;
        }
        .user-agent-cell {
            font-size: 12px;
            color: #64748b;
            max-width: 300px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            display: inline-block;
            vertical-align: middle;
        }
        .action-cell {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .logout-link {
            font-size: 0.75rem;
            color: #ef4444;
            text-decoration: none;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .logout-link:hover {
            text-decoration: underline;
        }

        @media (max-width: 768px) {
            .user-agent-cell {
                max-width: 120px;
                font-size: 11px;
            }
            .badge-current {
                font-size: 9px;
                padding: 1px 5px;
            }
        }
        @media (max-width: 480px) {
            .user-agent-cell {
                max-width: 80px;
                font-size: 10px;
            }
            .mui-filters-row {
                padding: 6px 10px;
                flex-direction: column;
                align-items: stretch;
            }
            .mui-filters-row .mui-filters-right input {
                width: 100%;
                box-sizing: border-box;
            }
        }

block scripts
    script(src="https://cdn.jsdelivr.net/npm/gridjs/dist/gridjs.umd.js")

block content
    script.
        document.addEventListener('DOMContentLoaded', function() {
            var sessions = !{JSON.stringify(sessions).replace(/<\//g, '\\u003c/')};
            var allData = sessions.map(function(s) {
                var loginDisplay = s.loginTime ? new Date(s.loginTime).toLocaleString() : 'unknown';
                return [s.sid, s.ip, s.userAgent, s.identifier || '', loginDisplay, s.currentUser];
            });

            var grid = null;
            var filteredData = allData.slice();
            var customSearchInput = document.getElementById('custom-search');

            function renderGrid() {
                var container = document.getElementById('sessions-grid');
                if (grid) {
                    grid.updateConfig({ data: filteredData }).forceRender();
                } else {
                    grid = new gridjs.Grid({
                        columns: [
                            { name: 'sid', hidden: true },
                            {
                                name: 'IP Address',
                                width: '170px',
                                sort: true
                            },
                            {
                                name: 'Browser / User-Agent',
                                width: 'auto',
                                sort: true,
                                formatter: function(cell) {
                                    return gridjs.html('<span class="user-agent-cell" title="' + escHtml(cell) + '">' + escHtml(cell) + '</span>');
                                }
                            },
                            {
                                name: 'Identifier',
                                width: '160px',
                                sort: true
                            },
                            {
                                name: 'Logged In',
                                width: '180px',
                                sort: true
                            },
                            {
                                name: 'Actions',
                                width: '160px',
                                sort: false,
                                formatter: function(cell, row) {
                                    var sid = row.cells[0].data;
                                    var isCurrent = row.cells[5].data;
                                    var html = '<div class="action-cell">';
                                    if (isCurrent) {
                                        html += '<span class="badge-current">You</span>';
                                        html += '<a href="/logout" class="logout-link">Logout</a>';
                                    } else {
                                        html += '<form method="POST" action="/sessions/' + encodeURIComponent(sid) + '/destroy" onsubmit="return confirm(\'Force logout this user? Their session will be destroyed immediately.\')" style="margin:0;">';
                                        html += '<input type="hidden" name="_csrf" value="' + (window.CSRF_TOKEN || '') + '">';
                                        html += '<button type="submit" class="action-btn">Force Logout</button>';
                                        html += '</form>';
                                    }
                                    html += '</div>';
                                    return gridjs.html(html);
                                }
                            }
                        ],
                        data: filteredData,
                        pagination: { limit: 15, summary: true },
                        search: { enabled: false },
                        sort: true,
                        language: {
                            'nothing found': '<div class="mui-empty"><i class="fas fa-server"></i>No authenticated sessions found.</div>'
                        },
                        className: {
                            table: 'gridjs-table',
                            thead: 'gridjs-thead',
                            th: 'gridjs-th',
                            tbody: 'gridjs-tbody',
                            td: 'gridjs-td'
                        }
                    }).render(container);
                }
            }

            function doCustomSearch() {
                var q = customSearchInput.value.toLowerCase();
                if (!q) {
                    filteredData = allData.slice();
                } else {
                    filteredData = allData.filter(function(row) {
                        for (var ci = 1; ci < 5; ci++) {
                            if (String(row[ci]).toLowerCase().indexOf(q) !== -1) return true;
                        }
                        return false;
                    });
                }
                renderGrid();
            }

            customSearchInput.addEventListener('input', doCustomSearch);

            document.getElementById('sessions-count').textContent = allData.length;

            renderGrid();
        });

    .sessions-grid-wrapper
        .mui-card
            .mui-filters-row
                .mui-filters-left
                    .mui-btn#btn-csv(style="display:none;")
                        i.fas.fa-file-csv
                        | CSV
                    .mui-btn#btn-copy(style="display:none;")
                        i.fas.fa-copy
                        | Copy
                    .mui-btn#btn-print(style="display:none;")
                        i.fas.fa-print
                        | Print
                    span(style="font-size:0.8125rem;color:#64748b;") 
                        span#sessions-count 0
                        |  active session(s)
                .mui-filters-right
                    input#custom-search(type="search" placeholder="Search sessions...")
            .mui-divider
            #sessions-grid
