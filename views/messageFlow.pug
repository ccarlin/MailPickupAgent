extends adminLayout

block css
  link(id="favicon" rel="icon" href="/img/MailPickupAgent.png" type="image/png")
  style.
    .mf-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 0.5rem;
      flex-wrap: wrap;
    }
    .mf-connection { display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: #64748b; }
    .mf-connection .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .mf-connection .dot.connected { background: #22c55e; }
    .mf-connection .dot.disconnected { background: #ef4444; }
    .mf-connection .dot.connecting { background: #f59e0b; }
    .mf-pill { background: #eef2ff; color: #4338ca; border-radius: 10px; padding: 2px 10px; font-size: 0.68rem; font-weight: 600; }
    .mf-updated { font-size: 0.8rem; color: #94a3b8; }

    .mf-grid { display: flex; gap: 24px; justify-content: center; align-items: flex-start; flex-wrap: wrap; }
    .mf-chart { flex: 1 1 420px; min-width: 320px; max-width: 520px; }
    .mf-chart svg { width: 100%; height: auto; }

    .mf-statcol { flex: 0 0 200px; min-width: 180px; }
    .mf-stat { border-left: 3px solid #6366f1; padding: 2px 0 6px 10px; margin-bottom: 6px; }
    .mf-stat .n { font-size: 1rem; font-weight: 700; color: #1e293b; }
    .mf-stat .l { font-size: 0.66rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.04em; }
    .mf-stat.whitelisted { border-color: #16a34a; }
    .mf-stat.released { border-color: #2563eb; }
    .mf-stat.quarantined { border-color: #d97706; }
    .mf-stat.blacklisted { border-color: #dc2626; }
    .mf-stat.deleted { border-color: #64748b; }
    .mf-stat[data-href], .fc-outcome[data-href] { cursor: pointer; }
    .mf-stat[data-href]:hover { background-color: #f1f5f9; }

    .mf-legend { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 8px; font-size: 0.72rem; color: #475569; }
    .mf-legend span { display: inline-flex; align-items: center; gap: 6px; }
    .mf-legend .sw { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
    .mf-legend code { background: #f1f5f9; border-radius: 4px; padding: 0 4px; }
    .mf-empty { display: none; text-align: center; color: #94a3b8; font-size: 0.85rem; margin-top: 8px; }

    .fc-stage { fill: #eef2ff; stroke: #6366f1; stroke-width: 1.5; }
    .fc-stage-title { font: 700 10px Roboto, sans-serif; text-anchor: middle; fill: #312e81; }
    .fc-stage-count { font: 700 12px Roboto, sans-serif; text-anchor: middle; fill: #1e293b; }
    .fc-edge { stroke: #94a3b8; stroke-width: 1.6; fill: none; marker-end: url(#mf-arrow); }
    .fc-envelope, .fc-edge, .fc-stage-title, .fc-stage-count, .fc-outcome-title, .fc-outcome-count { pointer-events: none; }
    .fc-outcome { stroke-width: 1.5; }
    .fc-outcome-title { font: 600 9px Roboto, sans-serif; text-anchor: middle; stroke: none; }
    .fc-outcome-count { font: 700 11px Roboto, sans-serif; text-anchor: middle; stroke: none; }
    .fc-outcome.wl { fill: #dcfce7; stroke: #16a34a; }
    .fc-outcome.wl .fc-outcome-title, .fc-outcome.wl .fc-outcome-count { fill: #166534; }
    .fc-outcome.bl { fill: #fee2e2; stroke: #dc2626; }
    .fc-outcome.bl .fc-outcome-title, .fc-outcome.bl .fc-outcome-count { fill: #991b1b; }
    .fc-outcome.released { fill: #dbeafe; stroke: #2563eb; }
    .fc-outcome.released .fc-outcome-title, .fc-outcome.released .fc-outcome-count { fill: #1e40af; }
    .fc-outcome.quarantined { fill: #fef3c7; stroke: #d97706; }
    .fc-outcome.quarantined .fc-outcome-title, .fc-outcome.quarantined .fc-outcome-count { fill: #92400e; }
    .fc-outcome.deleted { fill: #e2e8f0; stroke: #64748b; }
    .fc-outcome.deleted .fc-outcome-title, .fc-outcome.deleted .fc-outcome-count { fill: #334155; }

block content
  .mf-header
    .mf-connection
      span.dot.connecting#mf-connection-dot
      span#mf-connection-text Connecting...
    span.mf-updated(title="Counts are live since the last server restart and update automatically.")
      | Last updated: #[span#mf-last-update --]
    span.mf-pill(title="Counts are live since the last server restart and update automatically.") since last restart

  .mf-grid
    .mf-chart
      svg(viewBox="0 0 470 336" role="img" aria-label="Email processing pipeline flow")
        defs
          marker#mf-arrow(viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse")
            path(d="M0,0 L10,5 L0,10 z" fill="#94a3b8")

        path.fc-edge(d="M235,40 V64")
        path.fc-edge(d="M235,96 V120")
        path.fc-edge(d="M235,152 V176")
        path.fc-edge(d="M235,208 V232")

        rect.fc-stage(x="175" y="8" width="120" height="32" rx="8")
        text.fc-stage-title(x="235" y="24") INBOUND
        text.fc-stage-count(id="fc-inbound" x="235" y="36") 0

        rect.fc-stage(x="175" y="64" width="120" height="32" rx="8")
        text.fc-stage-title(x="235" y="80") WHITELIST CHECK
        text.fc-stage-count(id="fc-wl-reached" x="235" y="92") 0

        rect.fc-stage(x="175" y="120" width="120" height="32" rx="8")
          title Estimated count — derived from outcome counters; the agent does not record per-stage tallies.
        text.fc-stage-title(x="235" y="136") BLACKLIST CHECK
        text.fc-stage-count(id="fc-bl-reached" x="235" y="148") 0

        rect.fc-stage(x="175" y="176" width="120" height="32" rx="8")
          title Estimated count — derived from outcome counters; the agent does not record per-stage tallies.
        text.fc-stage-title(x="235" y="192") SCORE CALCULATION
        text.fc-stage-count(id="fc-scoring" x="235" y="204") 0

        rect.fc-stage(x="175" y="232" width="120" height="32" rx="8")
          title Estimated count — derived from outcome counters; the agent does not record per-stage tallies.
        text.fc-stage-title(x="235" y="248") THRESHOLD CHECK
        text.fc-stage-count(id="fc-threshold" x="235" y="260") 0

        path.fc-edge(d="M175,80 H95")
        g.fc-outcome.wl(data-href='/MailLog?result=Whitelisted')
          title View whitelisted emails
          rect(x="15" y="67" width="80" height="26" rx="7")
          text.fc-outcome-title(x="55" y="79") Whitelisted
          text.fc-outcome-count(id="fc-wl" x="55" y="90") 0

        path.fc-edge(d="M175,136 H95")
        g.fc-outcome.bl(data-href='/MailLog?result=Blacklisted')
          title View blacklisted / deleted emails
          rect(x="15" y="123" width="80" height="26" rx="7")
            title Combines emails stopped by blacklist rules with emails deleted for scoring ≥ THRESHOLD_DELETE.
          text.fc-outcome-title(x="55" y="135") Blacklisted*
          text.fc-outcome-count(id="fc-bl" x="55" y="146") 0

        path.fc-edge(d="M295,242 C320,242 320,248 345,248")
        g.fc-outcome.released(data-href='/MailLog?result=Released')
          title View released emails
          rect(x="345" y="234" width="90" height="28" rx="7")
          text.fc-outcome-title(x="390" y="248") Released
          text.fc-outcome-count(id="fc-released" x="390" y="259") 0

        path.fc-edge(d="M295,256 C320,256 320,282 345,282")
        g.fc-outcome.quarantined(data-href='/QuarantineLog')
          title View quarantine log
          rect(x="345" y="268" width="90" height="28" rx="7")
          text.fc-outcome-title(x="390" y="282") Quarantined
          text.fc-outcome-count(id="fc-quarantined" x="390" y="293") 0

        path.fc-edge(d="M295,264 C320,264 320,316 345,316")
        g.fc-outcome.deleted(data-href='/deleted')
          title View deleted messages
          rect(x="345" y="302" width="90" height="28" rx="7")
          text.fc-outcome-title(x="390" y="316") Deleted
          text.fc-outcome-count(id="fc-deleted" x="390" y="327") 0

        rect.fc-envelope(x="-5" y="-3.5" width="10" height="7" rx="1" fill="#6366f1")
          animateMotion(dur="1.6s" repeatCount="indefinite" path="M235,40 V64")
        rect.fc-envelope(x="-5" y="-3.5" width="10" height="7" rx="1" fill="#6366f1")
          animateMotion(dur="2.0s" repeatCount="indefinite" path="M235,152 V176")
        rect.fc-envelope(x="-5" y="-3.5" width="10" height="7" rx="1" fill="#16a34a")
          animateMotion(dur="2.4s" repeatCount="indefinite" path="M175,80 H95")
        rect.fc-envelope(x="-5" y="-3.5" width="10" height="7" rx="1" fill="#dc2626")
          animateMotion(dur="2.8s" repeatCount="indefinite" path="M175,136 H95")
        rect.fc-envelope(x="-5" y="-3.5" width="10" height="7" rx="1" fill="#2563eb")
          animateMotion(dur="2.6s" repeatCount="indefinite" path="M295,242 C320,242 320,248 345,248")
        rect.fc-envelope(x="-5" y="-3.5" width="10" height="7" rx="1" fill="#d97706")
          animateMotion(dur="3.0s" repeatCount="indefinite" path="M295,256 C320,256 320,282 345,282")
        rect.fc-envelope(x="-5" y="-3.5" width="10" height="7" rx="1" fill="#64748b")
          animateMotion(dur="3.2s" repeatCount="indefinite" path="M295,264 C320,264 320,316 345,316")

    .mf-statcol
      .mf-stat.whitelisted(data-href='/MailLog?result=Whitelisted' title="View whitelisted emails")
        .n#stat-wl 0
        .l Whitelisted
      .mf-stat.released(data-href='/MailLog?result=Released' title="View released emails")
        .n#stat-released 0
        .l Released
      .mf-stat.quarantined(data-href='/QuarantineLog' title="View quarantine log")
        .n#stat-quarantined 0
        .l Quarantined
      .mf-stat.blacklisted(data-href='/MailLog?result=Blacklisted' title="Combines emails stopped by blacklist rules with emails deleted for scoring ≥ THRESHOLD_DELETE.")
        .n#stat-bl 0
        .l Blacklisted / Deleted*
      .mf-stat.deleted
        .n#stat-deleted 0
        .l Deleted from queue

  .mf-legend
    span
      i.sw(style="background:#16a34a")
      | Whitelisted
    span
      i.sw(style="background:#2563eb")
      | Released
    span
      i.sw(style="background:#d97706")
      | Quarantined
    span
      i.sw(style="background:#64748b")
      | Deleted from queue
    span
      i.sw(style="background:#dc2626")
      | Blacklisted / Deleted
    span(title="Estimated count — derived from outcome counters; the agent does not record per-stage tallies.")
      code= '~'
      | estimated
    span(title="Combines emails stopped by blacklist rules with emails deleted for scoring ≥ THRESHOLD_DELETE.")
      code= '*'
      | combined counter

  #mf-empty.mf-empty No emails processed yet since the last restart.

block scripts
  script(src='/scripts/messageFlow.js')
  script.
    document.addEventListener('DOMContentLoaded', function () {
      function fmt(n) { return (n || 0).toLocaleString(); }

      function setText(id, value) {
        var el = document.getElementById(id);
        if (el) el.textContent = value;
      }

      function applyFlow(data) {
        var flow = window.MessageFlow.computeFlow(data);
        setText('fc-inbound', fmt(flow.inbound));
        setText('fc-wl-reached', fmt(flow.whitelistReached));
        setText('fc-bl-reached', '~' + fmt(flow.blacklistReached));
        setText('fc-scoring', '~' + fmt(flow.scoringReached));
        setText('fc-threshold', '~' + fmt(flow.thresholdReached));
        setText('fc-wl', fmt(flow.whitelisted));
        setText('fc-bl', fmt(flow.blacklisted));
        setText('fc-released', fmt(flow.released));
        setText('fc-quarantined', fmt(flow.quarantined));
        setText('fc-deleted', fmt(flow.deleted));
        setText('stat-wl', fmt(flow.whitelisted));
        setText('stat-released', fmt(flow.released));
        setText('stat-quarantined', fmt(flow.quarantined));
        setText('stat-bl', fmt(flow.blacklisted));
        setText('stat-deleted', fmt(flow.deleted));
        var empty = document.getElementById('mf-empty');
        if (empty) empty.style.display = flow.inbound === 0 ? 'block' : 'none';
        setText('mf-last-update', new Date().toLocaleTimeString());
      }

      function setConnection(state) {
        var dot = document.getElementById('mf-connection-dot');
        var text = document.getElementById('mf-connection-text');
        if (!dot || !text) return;
        dot.className = 'dot ' + state;
        text.textContent = state === 'connected' ? 'Live' : (state === 'connecting' ? 'Reconnecting…' : 'Disconnected');
      }

      setConnection('connecting');

      Array.prototype.forEach.call(document.querySelectorAll('[data-href]'), function (el) {
        el.addEventListener('click', function () {
          var href = this.getAttribute('data-href');
          if (href) window.open(href, '_blank');
        });
      });

      var es = new EventSource('/status/events');
      es.addEventListener('full', function (e) {
        try { applyFlow(JSON.parse(e.data)); } catch (err) { /* ignore malformed frame */ }
        setConnection('connected');
      });
      es.addEventListener('update', function (e) {
        try { applyFlow(JSON.parse(e.data)); } catch (err) { /* ignore malformed frame */ }
        setConnection('connected');
      });
      es.addEventListener('auth-error', function () {
        es.close();
        window.location.href = '/login';
      });
      es.onerror = function () {
        setConnection(es.readyState === EventSource.CONNECTING ? 'connecting' : 'disconnected');
      };
    });
