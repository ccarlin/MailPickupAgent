block content
    script.           
        $(document).ready(function ()
        {              
            var table = $('#myTable').DataTable({ 
                order: [[ 6, "desc" ]], 
                pageLength: 22,
                layout: {
                    topStart: { buttons: ['pageLength', 'copy', 'csv', 'excel', 'pdf', 'print']},
                    topEnd: 'search',
                    bottomStart: 'info',
                    bottomEnd: 'paging'                
                },                       
                language: {"emptyTable": "Nothing to see here move along.",  "zeroRecords": "No matches found."},
                initComplete: function () {
                    var btns = $('.dt-button');
                    btns.addClass('myMiniButton');
                    btns.removeClass('dt-button');  
                    [1].forEach(idx => multiFilterSetup(this.api().column(idx)));
                    dynamicPageLength('#myTable');
                 },
                footerCallback: function (row, data, start, end, display) {
                    var api = this.api();
                    var intVal = function (i) {
                        return typeof i === 'string' ? i.replace(/[\$,]/g, '') * 1 : typeof i === 'number' ? i : 0;
                    };
                    totalAttempts = api.column(5, {search:'applied'}).data().reduce(function (a, b) {
                        return intVal(a) + intVal(b);
                    }, 0);
                    totalFailures = api.column(6, {search:'applied'}).data().reduce(function (a, b) {
                        return intVal(a) + intVal(b);
                    }, 0);
                    totalFailedRelays = api.column(7, {search:'applied'}).data().reduce(function (a, b) {
                        return intVal(a) + intVal(b);
                    }, 0);
                    totalSuccess = api.column(8, {search:'applied'}).data().reduce(function (a, b) {
                        return intVal(a) + intVal(b);
                    }, 0);
                    $(api.column(5).footer()).html(totalAttempts.toLocaleString("en-US"));
                    $(api.column(6).footer()).html(totalFailures.toLocaleString("en-US"));
                    $(api.column(7).footer()).html(totalFailedRelays.toLocaleString("en-US"));
                    $(api.column(8).footer()).html(totalSuccess.toLocaleString("en-US"));
                },
                createdRow : function (row, data, dataIndex) {
                    if ((data[6] >  100)  || (data[9] > 50)) {                       
                        $(row).css({"color":"red"});
                    }
                }
            });
        });  
               
    form(action='/SMTPLog', method="POST")
        table#myTable(class="row-border compact order-column hover stripe" style="font-size: small;")
            thead    
                th(align='left' scope='col') IP Address
                th(align='left' scope='col') Country
                th(align='left' scope='col') First Seen
                th(align='left' scope='col') Last Seen
                th(align='left' scope='col') Days Seen
                th(align='left' scope='col') Attempts 
                th(align='left' scope='col') Failures
                th(align='left' scope='col') Failed Relay
                th(align='left' scope='col') Successes
                th(align='left' scope='col') #
                th(align='left' scope='col') Users
                th(align='left' scope='col' style="display: none;") IP Address
            each logEntry, idx in logData
                tr
                    td 
                        if (logEntry.UniqueIPCount > 1)
                            a(href=`${logEntry.ipLookup}`, target='_blank') #{logEntry.ipAddress} (#{logEntry.UniqueIPCount})
                        else 
                            a(href=`${logEntry.ipLookup}`, target='_blank') #{logEntry.ipAddress}
                    td(class=logEntry.BlockedIP? 'blockedIP':undefined) #{logEntry.Country}                       
                    td #{logEntry.FirstSeen}
                    td #{logEntry.LastSeen}
                    td #{logEntry.DaysSeen}
                    td #{logEntry.Attempts}
                    td #{logEntry.Failures}  
                    td #{logEntry.FailedSend} 
                    td #{logEntry.Success}     
                    td #{logEntry.UserCount}      
                    td #{logEntry.UserDisplay}
                    td(style="display:none;") #{logEntry.ipAddress}  
            tfoot 
                tr
                    th 
                    th 
                    th(style="text-align:right") Totals:
                    th(colspan="2" align='left')
                    th(align='left')
                    th(align='left')
                    th(align='left')
                    th(align='left')
                    th(align='left')
                    th(align='left')