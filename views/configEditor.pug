extends adminLayout

block css
    style.
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f5f5f5; color: #333; padding: 20px; }
        .container { max-width: 900px; margin: 0 auto; }
        h1 { margin-bottom: 8px; }
        .header-bar h1 { margin: 0; }
        .env-badge { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; text-transform: uppercase; }
        .env-badge.development { background: #e8f5e9; color: #2e7d32; }
        .env-badge.production { background: #fce4ec; color: #c62828; }
        .section { background: #fff; border: 1px solid #ddd; border-radius: 8px; margin-bottom: 20px; overflow: hidden; }
        .section-header { background: #f0f4f8; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ddd; cursor: pointer; }
        .section-header h2 { font-size: 15px; margin: 0; }
        .toggle-icon { font-size: 12px; margin-right: 6px; }
        .section-body { padding: 16px; }
        .section-body.collapsed { display: none; }
        .field-row { display: flex; gap: 16px; margin-bottom: 14px; flex-wrap: wrap; }
        .field { flex: 1; min-width: 200px; }
        .field label { display: block; font-weight: 600; font-size: 12px; color: #555; margin-bottom: 4px; word-break: break-all; }
        .field input, .field select { width: 100%; padding: 8px 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px; font-family: 'Consolas', 'Courier New', monospace; background: #fafafa; }
        .field input:focus, .field select:focus { outline: none; border-color: #1a73e8; box-shadow: 0 0 0 2px rgba(26,115,232,0.2); background: #fff; }
        .field input[type="checkbox"] { width: auto; margin-top: 6px; }
        .field .hint { font-size: 11px; color: #999; margin-top: 2px; }

        .modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center; }
        .modal-overlay.show { display: flex; }
        .modal-box { background: #fff; border-radius: 8px; max-width: 700px; width: 90%; max-height: 80vh; display: flex; flex-direction: column; box-shadow: 0 4px 20px rgba(0,0,0,0.3); }
        .modal-header { padding: 14px 18px; border-bottom: 1px solid #ddd; display: flex; justify-content: space-between; align-items: center; font-weight: 600; font-size: 15px; }
        .modal-header button { background: none; border: none; font-size: 20px; cursor: pointer; color: #666; }
        .modal-body { padding: 18px; overflow-y: auto; white-space: pre-wrap; font-family: 'Consolas', 'Courier New', monospace; font-size: 13px; line-height: 1.5; }
        .btn-outline-secondary { background: #fff; border: 1px solid #aaa; color: #555; cursor: pointer; border-radius: 4px; padding: 4px 10px; font-size: 12px; }
        .btn-outline-secondary:hover { background: #f0f0f0; }

    link(id="favicon" rel="icon" href="/img/MailPickupAgent.png" type="image/png")
block scripts
    script.
        let configData = null;
        const modelLists = {};
        let collapsedSections = { server: true, security: true, paths: true, smtp: true, ai: true, spamassassin: true, abuseipdb: true, thresholds: true, purge: true, test: true };

        function showToast(message, type, duration) {
            if (duration === undefined) duration = 2500;
            const existing = document.querySelector('.toast');
            if (existing) existing.remove();
            const toast = document.createElement('div');
            toast.className = 'toast ' + type;
            toast.textContent = message;
            document.body.appendChild(toast);
            requestAnimationFrame(() => toast.classList.add('show'));
            setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); }, duration);
        }

        function renderConfig() {
            const container = document.getElementById('configContainer');
            const previousValues = collectValues();
            container.innerHTML = '';

            if (!configData) return;

            const groups = [
                { key: 'server', title: 'Server', icon: '&#x1F5A5;', description: 'General web server settings', fields: [
                    { key: 'PORT', label: 'HTTP Port', type: 'number', hint: 'Port for the web server' },
                    { key: 'HOSTNAME', label: 'Hostname', hint: 'Hostname for logging' },
                ]},
                { key: 'security', title: 'Security', icon: '&#x1F512;', description: 'HTTPS certificate and authentication settings', fields: [
                    { key: 'CERT_KEY_PATH', label: 'SSL Private Key Path', hint: 'Path to the private key file (.key). Set this + CERT_PATH to enable HTTPS' },
                    { key: 'CERT_PATH', label: 'SSL Certificate Path', hint: 'Path to the certificate file (.crt or .pem)' },
                    { key: 'AUTH_USERNAME', label: 'Admin Username', hint: 'Username for the admin login page' },
                    { key: 'AUTH_PASSWORD_NEW', label: 'Admin Password', type: 'password', hint: 'Enter a new password to change it (leave blank to keep current)' },
                    { key: 'AUTH_SECRET', label: 'Session Secret', type: 'password', hint: 'Random string used to sign session cookies' },
                ]},
                { key: 'paths', title: 'Directory Paths', icon: '&#x1F4C1;', description: 'File system paths for email storage and logs', fields: [
                    { key: 'QUARANTINE_DIR', label: 'Quarantine Directory', hint: 'Where quarantined emails are stored' },
                    { key: 'DELETED_DIR', label: 'Deleted Directory', hint: 'Where deleted emails are moved' },
                    { key: 'SMTP_QUEUE_DIR', label: 'SMTP Queue Directory', hint: 'Inbound SMTP message queue' },
                    { key: 'SMTP_COMMAND_DIR', label: 'SMTP Command Directory', hint: 'Inbound SMTP control files' },
                    { key: 'SMTP_LOG_DIR', label: 'SMTP Log Directory', hint: 'Mail Enable SMTP logs location' },
                    { key: 'PROCESSING_LOG', label: 'Processing Log Directory', hint: 'Where processing-YYYYMMDD.log files go' },
                    { key: 'QUARANTINE_LOG', label: 'Quarantine Log Directory', hint: 'Where quarantine-YYYYMMDD.log files go' },
                    { key: 'CURRENT_LOG_FILE', label: 'Current Log File', hint: 'Full path to the log file shown in the Current Log popup (e.g. C:/MailPickupAgent/mailpickup.log)' },
                ]},
                { key: 'smtp', title: 'SMTP Settings', icon: '&#x2709;', description: 'Outbound mail server connection for sending test emails', fields: [
                    { key: 'SMTP_HOST', label: 'SMTP Host', hint: 'Mail server for releasing emails' },
                    { key: 'SMTP_PORT', label: 'SMTP Port', type: 'number', hint: 'Usually 25' },
                    { key: 'SMTP_USER', label: 'SMTP Username', hint: 'Authentication user (if required)' },
                    { key: 'SMTP_PASS', label: 'SMTP Password', type: 'password', hint: 'Authentication password' },                   
                ]},
                { key: 'ai', title: 'AI Classification', icon: '&#x1F916;', description: 'AI-powered spam classification via Ollama or llama.cpp', fields: [
                    { key: 'AI_CHECK_ENABLED', label: 'AI Check Enabled', type: 'checkbox', hint: 'Enable AI spam classification' },
                    { key: 'AI_SYSTEM', label: 'AI System', type: 'select', options: ['OLLAMA', 'LLAMACPP'], hint: 'Select the AI server used for spam classification' },
                    { key: 'OLLAMA_SERVER', label: 'Ollama Server', hint: 'Hostname or IP of Ollama server' },
                    { key: 'OLLAMA_PORT', label: 'Ollama Port', type: 'number', hint: 'Default 11434' },
                    { key: 'OLLAMA_MODEL', label: 'Ollama Model', hint: 'Select an available model; manual entry is available if the list cannot be retrieved', modelSystem: 'OLLAMA' },
                    { key: 'OLLAMA_TIMEOUT', label: 'Ollama Timeout', type: 'number', min: 1, max: 120, hint: 'Request timeout in seconds (1-120, default 5)' },
                    { key: 'LLAMACPP_SERVER', label: 'llama.cpp Server', hint: 'Hostname, IP, or URL of the llama.cpp server' },
                    { key: 'LLAMACPP_PORT', label: 'llama.cpp Port', type: 'number', hint: 'Default 8080; ignored when the server value includes a port' },
                    { key: 'LLAMACPP_MODEL', label: 'llama.cpp Model', hint: 'Select an available model; manual entry is available if the list cannot be retrieved', modelSystem: 'LLAMACPP' },
                    { key: 'AI_SPAM_POINTS', label: 'AI Spam Points', type: 'number', step: '0.1', min: 0, max: 10, hint: 'Points added to score when AI classifies as SPAM (0.0 - 10.0)' },
                    { key: 'AI_HAM_POINTS', label: 'AI Ham Points', type: 'number', step: '0.1', min: 0, max: 10, hint: 'Points removed from score when AI classifies as HAM (0.0 - 10.0)' },
                    { key: 'AI_SPAM_CHECK_PROMPT_PATH', label: 'AI Prompt Path', hint: 'Path to the spam check prompt markdown file', hasViewBtn: true },
                ]},
                { key: 'spamassassin', title: 'SpamAssassin', icon: '&#x1F6E1;', description: 'Spam filtering via SpamAssassin daemon 0-15 score range', fields: [
                    { key: 'SPAMASSASSIN_ENABLED', label: 'SpamAssassin Enabled', type: 'checkbox', hint: 'Enable SpamAssassin spam checks' },
                    { key: 'SPAMASSASSIN_HOST', label: 'SpamAssassin Host', hint: 'Hostname or IP of spamd' },
                    { key: 'SPAMASSASSIN_PORT', label: 'SpamAssassin Port', type: 'number', hint: 'Default 783' },
                ]},
                { key: 'abuseipdb', title: 'AbuseIPDB', icon: '&#x1F6E1;', description: 'IP reputation checking via <a href="https://www.abuseipdb.com/" target="_blank">AbuseIPDB</a> API. Check runs when an API key is set.', fields: [
                    { key: 'ABUSEIPDB_KEY', label: 'API Key', type: 'password', hint: 'AbuseIPDB API key (get one at abuseipdb.com)' },
                    { key: 'ABUSEIPDB_TIMEOUT', label: 'Timeout', type: 'number', min: 1, max: 30, hint: 'Request timeout in seconds (1-30, default 5)' },
                    { key: 'ABUSEIPDB_BASE_SCORE', label: 'Base Score', type: 'number', step: '0.1', min: 0, max: 50, hint: 'Minimum score assigned when IP has abuse reports (default 5)' },
                    { key: 'ABUSEIPDB_MAX_SCORE', label: 'Max Score', type: 'number', step: '0.1', min: 0, max: 50, hint: 'Maximum score at 100% abuse confidence (default 15)' },
                ]},
                { key: 'thresholds', title: 'Spam Thresholds', icon: '&#x2699;', description: 'Score boundaries for quarantine and delete actions', fields: [
                    { key: 'THRESHOLD_QUARANTINE', label: 'Quarantine Threshold', type: 'number', hint: 'Score at or above this value quarantines the email' },
                    { key: 'THRESHOLD_DELETE', label: 'Delete Threshold', type: 'number', hint: 'Score at or above this value deletes the email' },
                ]},
                { key: 'purge', title: 'Purge / Retention', icon: '&#x1F9F9;', description: 'Automatic cleanup of old deleted emails, log files, and configuration backups', fields: [
                    { key: 'PURGE_EMAIL_AFTER_DAYS', label: 'Email Retention (days)', type: 'number', hint: 'Remove deleted emails older than this many days' },
                    { key: 'PURGE_LOG_AFTER_DAYS', label: 'Log Retention (days)', type: 'number', hint: 'Remove log files older than this many days' },
                    { key: 'PURGE_INCLUDE_SMTP_LOGS', label: 'Include SMTP Logs', type: 'checkbox', hint: 'Also purge files in SMTP_LOG_DIR with log retention' },
                    { key: 'BACKUP_MAX_COUNT', label: 'Backup Max Count', type: 'number', hint: 'Maximum number of config/rules backups to keep' },
                    { key: 'BACKUP_MAX_DAYS', label: 'Backup Retention (days)', type: 'number', hint: 'Remove config/rules backups older than this many days' },
                ]},              
                { key: 'test', title: 'Test Emails', icon: '&#x1F514;', description: 'Configuration for automated test email generation', fields: [
                    { key: 'TEST_EMAIL_SLEEP_SECONDS', label: 'Sleep Between Tests', type: 'number', hint: 'Seconds to wait between test emails' },
                    { key: 'TEST_EMAIL_FROM', label: 'Test Email From Address', hint: 'Sender address for test emails' },
                    { key: 'TEST_EMAIL_RECIPIENT', label: 'Test Email Recipient', hint: 'Default recipient for test emails' },
                ]},
            ];

            groups.forEach(group => {
                const section = document.createElement('div');
                section.className = 'section';

                const isCollapsed = collapsedSections[group.key];

                const header = document.createElement('div');
                header.className = 'section-header';
                header.style.flexDirection = 'column';
                header.style.alignItems = 'flex-start';
                header.innerHTML = '<h2><span class="toggle-icon">' + (isCollapsed ? '&#9654;' : '&#9660;') + '</span>' + group.icon + ' ' + group.title + '</h2><div style="font-size:12px;color:#777;padding: 2px 0 0 18px;">' + group.description + '</div>';
                header.addEventListener('click', (e) => {
                    if (e.target.closest('.actions')) return;
                    collapsedSections[group.key] = !collapsedSections[group.key];
                    renderConfig();
                });

                const body = document.createElement('div');
                body.className = 'section-body' + (isCollapsed ? ' collapsed' : '');

                group.fields.forEach(field => {
                    const value = configData[field.key];

                    const row = document.createElement('div');
                    row.className = 'field-row';

                    const fieldDiv = document.createElement('div');
                    fieldDiv.className = 'field';

                    const label = document.createElement('label');
                    label.setAttribute('for', 'cfg-' + field.key);
                    label.textContent = field.key;
                    fieldDiv.appendChild(label);

                    if (field.type === 'checkbox') {
                        const cb = document.createElement('input');
                        cb.type = 'checkbox';
                        cb.id = 'cfg-' + field.key;
                        cb.checked = value === true || value === 'true';
                        cb.dataset.key = field.key;
                        fieldDiv.appendChild(cb);
                    } else if (field.type === 'select') {
                        const select = document.createElement('select');
                        select.id = 'cfg-' + field.key;
                        select.dataset.key = field.key;
                        (field.options || []).forEach(optionValue => {
                            const option = document.createElement('option');
                            option.value = optionValue;
                            option.textContent = optionValue;
                            option.selected = String(value || '').toUpperCase() === optionValue;
                            select.appendChild(option);
                        });
                        fieldDiv.appendChild(select);
                    } else {
                        const input = document.createElement('input');
                        input.type = field.type || 'text';
                        input.id = 'cfg-' + field.key;
                        input.value = value != null ? String(value) : '';
                        input.dataset.key = field.key;
                        if (field.type === 'password') {
                            input.type = 'password';
                        }
                        if (field.step) input.step = field.step;
                        if (field.min !== undefined) input.min = field.min;
                        if (field.max !== undefined) input.max = field.max;
                        if (field.modelSystem) {
                            input.dataset.modelSystem = field.modelSystem;
                        }
                        fieldDiv.appendChild(input);
                    }

                    if (field.hint) {
                        const hint = document.createElement('div');
                        hint.className = 'hint';
                        hint.textContent = field.hint;
                        fieldDiv.appendChild(hint);
                    }

                    if (field.modelSystem) {
                        const status = document.createElement('div');
                        status.className = 'hint model-list-status';
                        status.dataset.modelSystem = field.modelSystem;
                        fieldDiv.appendChild(status);
                    }

                    if (field.hasViewBtn) {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn btn-sm btn-outline-secondary';
                        btn.style.marginTop = '6px';
                        btn.textContent = 'View Prompt';
                        btn.addEventListener('click', () => openPromptModal());
                        fieldDiv.appendChild(btn);
                    }

                    row.appendChild(fieldDiv);
                    body.appendChild(row);
                });

                section.appendChild(header);
                section.appendChild(body);
                container.appendChild(section);
            });

            const savedKeys = Object.keys(previousValues);
            if (savedKeys.length) {
                savedKeys.forEach(key => {
                    if (key === 'AUTH_PASSWORD_NEW') return;
                    const input = document.getElementById('cfg-' + key);
                    if (!input) return;
                    if (input.type === 'checkbox') {
                        input.checked = previousValues[key] === true || previousValues[key] === 'true';
                    } else {
                        input.value = previousValues[key] != null ? String(previousValues[key]) : '';
                    }
                });
            }

            refreshModelLists();
        }

        function collectValues() {
            const values = {};
            document.querySelectorAll('#configContainer input, #configContainer select').forEach(input => {
                const key = input.dataset.key;
                if (!key) return;
                if (input.type === 'checkbox') {
                    values[key] = input.checked;
                } else {
                    values[key] = input.value;
                }
            });
            return values;
        }

        function updateModelList(system, models, message) {
            const modelKey = system + '_MODEL';
            const control = document.getElementById('cfg-' + modelKey);
            const currentValue = control ? control.value : (configData[modelKey] || '');

            if (models.length && control) {
                const selector = document.createElement('select');
                selector.id = control.id;
                selector.dataset.key = modelKey;
                selector.dataset.modelSystem = system;
                if (!currentValue) {
                    const placeholder = document.createElement('option');
                    placeholder.value = '';
                    placeholder.textContent = 'Select an available model...';
                    placeholder.disabled = true;
                    placeholder.selected = true;
                    selector.appendChild(placeholder);
                }
                models.forEach(model => {
                    const option = document.createElement('option');
                    option.value = model;
                    option.textContent = model;
                    selector.appendChild(option);
                });
                if (currentValue && !models.includes(currentValue)) {
                    const currentOption = document.createElement('option');
                    currentOption.value = currentValue;
                    currentOption.textContent = currentValue;
                    selector.appendChild(currentOption);
                }
                selector.value = currentValue;
                control.replaceWith(selector);
            } else if (!models.length && control && control.tagName === 'SELECT') {
                const input = document.createElement('input');
                input.type = 'text';
                input.id = control.id;
                input.value = currentValue;
                input.dataset.key = modelKey;
                input.dataset.modelSystem = system;
                control.replaceWith(input);
            }
            document.querySelectorAll('.model-list-status[data-model-system="' + system + '"]').forEach(status => {
                status.textContent = message || '';
            });
        }

        async function refreshModelList(system) {
            const server = document.getElementById('cfg-' + system + '_SERVER')?.value.trim();
            const port = document.getElementById('cfg-' + system + '_PORT')?.value.trim();
            if (!server || !port) {
                updateModelList(system, [], 'Configure the server and port to load available models. You can still enter a model manually.');
                return;
            }

            const cacheKey = system + '|' + server + '|' + port;
            if (modelLists[cacheKey]) {
                updateModelList(system, modelLists[cacheKey]);
                return;
            }

            updateModelList(system, [], 'Loading available models...');
            try {
                const params = new URLSearchParams({ system, server, port });
                const response = await fetch('/configEditor/api/config/ai-models?' + params.toString());
                if (!response.ok) throw new Error('Model list unavailable');
                const data = await response.json();
                const models = Array.isArray(data.models) ? data.models : [];
                modelLists[cacheKey] = models;
                updateModelList(system, models, models.length ? '' : 'No models were returned. Enter a model manually.');
            } catch (error) {
                updateModelList(system, [], 'Could not retrieve models. Enter a model manually.');
            }
        }

        function refreshModelLists() {
            refreshModelList('OLLAMA');
            refreshModelList('LLAMACPP');
        }

        async function fetchConfig() {
            try {
                const resp = await fetch('/configEditor/api/config');
                if (!resp.ok) throw new Error('Failed to fetch config');
                configData = await resp.json();
                renderConfig();
                document.getElementById('lastSaved').textContent = 'Loaded';
            } catch (err) {
                console.error('Error fetching config:', err);
                showToast('Could not load configuration', 'error');
            }
        }

        async function saveConfig() {
            const values = collectValues();
            if (values.PORT && configData.PORT && String(values.PORT) !== String(configData.PORT)) {
                if (!confirm('WARNING: The port number has been changed from ' + configData.PORT + ' to ' + values.PORT + '.\n\nYou must manually update the port in mailServerPickup.bat to match.\nThe server must also be restarted for this change to take effect.\n\nAre you sure you want to save this change?')) {
                    return;
                }
            }
            try {
                const resp = await fetch('/configEditor/api/config/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ values })
                });
                if (!resp.ok) {
                    const errData = await resp.json();
                    throw new Error(errData.message || 'Save failed');
                }
                document.getElementById('lastSaved').textContent = 'Saved at ' + new Date().toLocaleTimeString();
                if (values.CERT_PATH && values.CERT_PATH.trim() !== '' && window.location.protocol !== 'https:') {
                    showToast('Certificate configured \u2014 restart the service to run in secure mode (HTTPS). Remote access will require login.', 'info', 5000);
                } else {
                    showToast('Configuration saved and reloaded!', 'success');
                }
            } catch (err) {
                console.error('Error saving config:', err);
                showToast('Failed to save: ' + err.message, 'error');
            }
        }

        document.addEventListener('click', (e) => {
            if (e.target.classList.contains('modal-overlay')) closePromptModal();
        });

        function openPromptModal() {
            document.getElementById('promptContent').textContent = 'Loading...';
            document.getElementById('promptModal').classList.add('show');
            fetch('/configEditor/api/config/ai-prompt')
                .then(r => r.json())
                .then(data => {
                    document.getElementById('promptContent').textContent = data.content || 'No content';
                })
                .catch(err => {
                    document.getElementById('promptContent').textContent = 'Error loading prompt: ' + err.message;
                });
        }

        function closePromptModal() {
            document.getElementById('promptModal').classList.remove('show');
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('saveButton').addEventListener('click', saveConfig);
            document.getElementById('configContainer').addEventListener('change', (event) => {
                const key = event.target.dataset.key;
                if (key === 'OLLAMA_SERVER' || key === 'OLLAMA_PORT') refreshModelList('OLLAMA');
                if (key === 'LLAMACPP_SERVER' || key === 'LLAMACPP_PORT') refreshModelList('LLAMACPP');
            });
            fetchConfig();
            const hb = document.querySelector('.header-bar');
            const scroller = document.querySelector('.right-column');
            if (hb && scroller) {
                scroller.addEventListener('scroll', () => hb.classList.toggle('scrolled', scroller.scrollTop > 0));
            }
        });

block content
    .container
        .header-bar
            div
                span#lastSaved(style='font-size:13px;color:#888;')
            div(style='display:flex;align-items:center;gap:12px;')
                span.env-badge(class= envClass || 'development')= envLabel || 'development'
                button#saveButton.btn.btn-primary Save Changes
        #configContainer

        #promptModal.modal-overlay
            .modal-box
                .modal-header
                    span AI Spam Check Prompt
                    button(onclick='closePromptModal()') &times;
                .modal-body#promptContent Loading...
