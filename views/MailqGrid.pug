        }
        .mailq-grid-wrapper th .gridjs-th-content {
            float: left;
            white-space: nowrap;
            overflow: visible !important;
            text-overflow: clip !important;
            width: calc(100% - 16px);
        }
        .mailq-grid-wrapper th .gridjs-sort {
            filter: brightness(0) invert(1);
            opacity: 0.7;
