                            color: #64748b;
                            background: #f8fafc;
                            border-bottom: 1px solid #e2e8f0;
                            white-space: normal;
                            word-break: break-word;
                            line-height: 1.4;
                        }
                        .reason-subrow:hover {
                            background: transparent;
