block scripts
    script(src="https://cdn.jsdelivr.net/npm/gridjs/dist/gridjs.umd.js")

block content
    script.
        var hsFilterUser = !{JSON.stringify(filterUser || null)};

        document.addEventListener('DOMContentLoaded', function() {
            var emailData = !{JSON.stringify(emails)};
            var emailStore = {};
            var allData = emailData.map(function(e) {
                var score = isNaN(Number(e.spamScore)) ? e.spamScore : +Number(e.spamScore).toFixed(1);
                var row = [e.filepath, e.recipients, e.sender, e.subject, String(score), e.antiSpam, e.date, e.clientip, e.dkim, e.safe, e.clientipinfo];
                emailStore[e.filepath] = { subject: e.subject, sender: e.sender, recipients: e.recipients, spamScore: score, antiSpam: e.antiSpam, reason: e.reason, clientip: e.clientip, datetime: e.date, dkim: e.dkim };
                return row;
            });

            var grid = null;
            var filteredData = allData.slice();
            var customSearchInput = document.getElementById('custom-search');
            document.getElementById('last-update').textContent = '#{currentTime}';

            setTimeout(function() { location.reload(true); }, 600000);

            function selectAll(checked) {
                document.querySelectorAll('.mailq-chk').forEach(function(cb) { cb.checked = checked; });
            }

            function getCheckedFilepaths() {
                var result = [];
                document.querySelectorAll('.mailq-chk:checked').forEach(function(cb) { result.push(cb.value); });
                return result;
            }

            function confirmCheck(action) {
                var checked = getCheckedFilepaths();
                if (checked.length === 0) {
                    alert('Please select one or more messages.');
                    return false;
                }
                return confirm('Are you sure you wish to ' + action + ' ' + checked.length + ' email(s)?');
            }

            function doBatchAction(action) {
                if (!confirmCheck(action)) return;
                var checked = getCheckedFilepaths();
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/mailq';
                form.style.display = 'none';
                var inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'action';
                inp.value = action.charAt(0).toUpperCase() + action.slice(1);
                form.appendChild(inp);
                checked.forEach(function(fp) {
                    var h = document.createElement('input');
                    h.type = 'hidden';
                    h.name = fp;
                    h.value = 'on';
                    form.appendChild(h);
                    var data = emailStore[fp];
                    if (data) {
                        Object.keys(data).forEach(function(k) {
                            var f = document.createElement('input');
                            f.type = 'hidden';
                            f.name = 'data[' + fp + '][' + k + ']';
                            f.value = data[k];
                            form.appendChild(f);
                        });
                    }
                });
                document.body.appendChild(form);
                form.submit();
            }

            function doFilterClear() {
                if (!confirm('Clear MailQ user filter?')) return;
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/mailq';
                form.style.display = 'none';
                var inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'action';
                inp.value = 'Filter Clear';
                form.appendChild(inp);
                document.body.appendChild(form);
                form.submit();
            }

            function showBatchListingModal(action) {
                var checked = getCheckedFilepaths();
                if (checked.length === 0) {
                    alert('Please select one or more messages.');
                    return;
                }
                pendingAction = action;
                pendingItems = [];
                checked.forEach(function(fp) {
                    var data = emailStore[fp];
                    if (data) pendingItems.push({ sender: data.sender });
                });
                document.getElementById('listingModalTitle').textContent = (action === 'whitelist' ? 'Whitelist' : 'Blacklist') + ' Senders';
                renderListingPreview();
                document.getElementById('listingModal').style.display = 'block';
            }

            var pendingAction = null;
            var pendingItems = [];

            function renderListingPreview() {
                var isDomain = document.querySelector('input[name="listTypeChoice"]:checked').value === 'domain';
                var seen = {};
                var list = document.getElementById('listingAddressList');
                list.innerHTML = '';
                pendingItems.forEach(function(item) {
                    var display = isDomain ? extractDomain(item.sender) : item.sender;
                    if (!seen[display]) {
                        seen[display] = true;
                        var div = document.createElement('div');
                        div.textContent = display;
                        list.appendChild(div);
                    }
                });
            }

            function extractDomain(email) {
                var atIndex = email.lastIndexOf('@');
                if (atIndex !== -1) return '@' + email.slice(atIndex + 1);
                return email;
            }

            function confirmListing() {
                var isDomain = document.querySelector('input[name="listTypeChoice"]:checked').value === 'domain';
                document.getElementById('listingModal').style.display = 'none';
                if (pendingItems.length === 1 && pendingItems[0]._btn) {
                    performSingleAction(pendingAction, pendingItems[0], isDomain ? 'domain' : 'email');
                } else {
                    var checked = getCheckedFilepaths();
                    var form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/mailq';
                    form.style.display = 'none';
                    var inp = document.createElement('input');
                    inp.type = 'hidden';
                    inp.name = 'action';
                    inp.value = pendingAction;
                    form.appendChild(inp);
                    var lt = document.createElement('input');
                    lt.type = 'hidden';
                    lt.name = 'listType';
                    lt.value = isDomain ? 'domain' : 'email';
                    form.appendChild(lt);
                    checked.forEach(function(fp) {
                        var h = document.createElement('input');
                        h.type = 'hidden';
                        h.name = fp;
                        h.value = 'on';
                        form.appendChild(h);
                        var data = emailStore[fp];
                        if (data) {
                            Object.keys(data).forEach(function(k) {
                                var f = document.createElement('input');
                                f.type = 'hidden';
                                f.name = 'data[' + fp + '][' + k + ']';
                                f.value = data[k];
                                form.appendChild(f);
                            });
                        }
                    });
                    document.body.appendChild(form);
                    form.submit();
                }
                pendingAction = null;
                pendingItems = [];
            }

            function closeListingModal() {
                document.getElementById('listingModal').style.display = 'none';
                pendingAction = null;
                pendingItems = [];
            }

            function showSingleListingModal(btn) {
                var action = btn.classList.contains('btn-blacklist') ? 'blacklist' : 'whitelist';
                var rawKey = btn.getAttribute('data-mailkey') || '';
                var filepath = rawKey ? decodeURIComponent(rawKey) : '';
                if (!filepath) return;
                pendingAction = action;
                pendingItems = [];
                var data = emailStore[filepath];
                pendingItems.push({
                    filepath: filepath,
                    sender: data ? data.sender : '',
                    _btn: btn,
                    subject: data ? data.subject : '',
                    recipients: data ? data.recipients : '',
                    spamScore: data ? data.spamScore : '',
                    antiSpam: data ? data.antiSpam : '',
                    datetime: data ? data.datetime : '',
                    dkim: data ? data.dkim : ''
                });
                document.getElementById('listingModalTitle').textContent = (action === 'whitelist' ? 'Whitelist' : 'Blacklist') + ' Sender';
                renderListingPreview();
                document.getElementById('listingModal').style.display = 'block';
            }

            function performSingleAction(action, item, listType) {
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/mailq/action';
                form.style.display = 'none';
                function addField(name, value) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = name;
                    input.value = value;
                    form.appendChild(input);
                }
                addField('action', action);
                addField('filePath', item.filepath);
                addField('subject', item.subject);
                addField('sender', item.sender);
                addField('recipients', item.recipients);
                addField('spamScore', item.spamScore);
                addField('antiSpam', item.antiSpam);
                addField('clientip', '');
                addField('datetime', item.datetime);
                addField('dkim', item.dkim);
                addField('listType', listType);
                document.body.appendChild(form);
                form.submit();
            }

            function closePreviewModal() {
                document.getElementById('emailPreviewModal').style.display = 'none';
                document.getElementById('emailPreviewFrame').src = '';
            }

            document.addEventListener('click', function(e) {
                var link = e.target.closest('.preview-link');
                if (!link) return;
                e.preventDefault();
                var key = link.getAttribute('data-mailkey');
                var view = link.getAttribute('data-view');
                if (!key) return;
                var url = view === 'html' ? 'emailPreview?view=HTML&mailKey=' + encodeURIComponent(key) : 'emailPreview?mailKey=' + encodeURIComponent(key);
                document.getElementById('emailPreviewFrame').src = url;
                document.getElementById('emailPreviewModal').style.display = 'block';
            });

            document.getElementById('chkSelectAll').addEventListener('change', function() {
                selectAll(this.checked);
            });

            document.getElementById('btn-delete-all').addEventListener('click', function() {
                selectAll(true);
                doBatchAction('delete');
            });

            document.getElementById('btn-delete').addEventListener('click', function() { doBatchAction('delete'); });
            document.getElementById('btn-release').addEventListener('click', function() { doBatchAction('release'); });
            document.getElementById('btn-whitelist').addEventListener('click', function() { showBatchListingModal('whitelist'); });
            document.getElementById('btn-blacklist').addEventListener('click', function() { showBatchListingModal('blacklist'); });

            var filterClearBtn = document.getElementById('btn-filter-clear');
            if (filterClearBtn) {
                filterClearBtn.addEventListener('click', doFilterClear);
            }

            document.querySelectorAll('input[name="listTypeChoice"]').forEach(function(el) {
                el.addEventListener('change', renderListingPreview);
            });

            document.getElementById('listingModalCloseBtn').addEventListener('click', closeListingModal);
            document.getElementById('listingConfirmBtn').addEventListener('click', confirmListing);
            document.getElementById('listingCancelBtn').addEventListener('click', closeListingModal);
            document.getElementById('previewCloseBtn').addEventListener('click', closePreviewModal);

            function renderGrid() {
                var container = document.getElementById('mailq-grid');
                if (grid) {
                    grid.updateConfig({ data: filteredData });
                    grid.forceRender();
                } else {
                    grid = new gridjs.Grid({
                        columns: [
                            {
                                name: ' ',
                                id: 'chk',
                                width: '40px',
                                sort: false,
                                formatter: function(cell) {
                                    return gridjs.html('<input type="checkbox" class="mailq-chk" value="' + cell.replace(/"/g, '&quot;') + '">');
                                }
                            },
                            { name: 'Recipients', id: 'recipients', width: '180px', sort: true },
                            {
                                name: 'Sender',
                                id: 'sender',
                                width: '200px',
                                sort: true,
                                formatter: function(cell, row) {
                                    var raw = cell;
                                    var safe = row.cells[9].data;
                                    var cls = (safe === false || safe === 'false') ? 'sender-danger' : '';
                                    return gridjs.html('<span class="' + cls + '">' + raw.replace(/</g, '&lt;') + '</span>');
                                }
                            },
                            { name: 'Subject', id: 'subject', width: '220px', sort: true },
                            { name: 'Score', id: 'score', width: '65px', sort: true },
                            { name: 'Spam Detail', id: 'spamdetail', width: '150px', sort: true },
                            { name: 'Date/Time', id: 'datetime', width: '160px', sort: true },
                            {
                                name: 'ClientIP',
                                id: 'clientip',
                                width: '130px',
                                sort: true,
                                formatter: function(cell) {
                                    return gridjs.html('<a href="https://www.ipqualityscore.com/ip-reputation-check/lookup/' + encodeURIComponent(cell) + '" target="_blank">' + cell + '</a>');
                                }
                            },
                            { name: 'DKIM', id: 'dkim', width: '80px', sort: true },
                            {
                                name: 'Actions',
                                id: 'actions',
                                width: '150px',
                                sort: false,
                                formatter: function(cell, row) {
                                    var fp = row.cells[0].data;
                                    var safe = row.cells[9].data;
                                    var html = '<button class="action-btn preview-link" data-mailkey="' + fp.replace(/"/g, '&quot;') + '" data-view="text" title="Plain Text Preview"><i class="material-icons">article</i></button>';
                                    if (safe === true || safe === 'true') {
                                        html += '&nbsp;<button class="action-btn preview-link" data-mailkey="' + fp.replace(/"/g, '&quot;') + '" data-view="html" title="HTML Preview"><i class="material-icons">visibility</i></button>';
                                    }
                                    html += '&nbsp;<button class="action-btn btn-whitelist" type="button" title="Whitelist Sender" data-mailkey="' + encodeURIComponent(fp) + '"><i class="material-icons">check_circle</i></button>';
                                    html += '&nbsp;<button class="action-btn btn-blacklist" type="button" title="Blacklist Sender" data-mailkey="' + encodeURIComponent(fp) + '"><i class="material-icons">block</i></button>';
                                    return gridjs.html(html);
                                }
                            },
                            { name: 'safe', id: 'safe', hidden: true },
                            { name: 'clientipinfo', id: 'clientipinfo', hidden: true }
                        ],
                        data: filteredData,
                        pagination: false,
                        search: { enabled: false },
                        sort: true,
                        language: {
                            'nothing found': '<div class="mui-empty"><i class="fas fa-inbox"></i>Nothing to see here move along.</div>'
                        },
                        className: {
                            table: 'gridjs-table',
                            thead: 'gridjs-thead',
                            th: 'gridjs-th',
                            tbody: 'gridjs-tbody',
                            td: 'gridjs-td'
                        }
                    }).render(container);
                }
            }

            var reasonObserver = null;

            function insertReasonSubRows() {
                var table = document.querySelector('.gridjs-table');
                if (!table) return;

                if (reasonObserver) reasonObserver.disconnect();

                var tbody = table.querySelector('tbody');
                if (!tbody) { if (reasonObserver) reasonObserver.observe(table, { childList: true, subtree: true }); return; }

                tbody.querySelectorAll('.reason-subrow').forEach(function(el) { el.remove(); });
                var rows = tbody.querySelectorAll('tr');
                rows.forEach(function(row) {
                    if (row.classList.contains('reason-subrow')) return;
                    var checkbox = row.querySelector('.mailq-chk');
                    if (!checkbox) return;
                    var filepath = checkbox.value;
                    var emailData = emailStore[filepath];
                    var reason = emailData ? emailData.reason : '';
                    if (!reason) return;
                    var subRow = document.createElement('tr');
                    subRow.className = 'reason-subrow';
                    var cell = document.createElement('td');
                    cell.setAttribute('colspan', '100');
                    cell.innerHTML = '<strong>Reason:</strong> ' + reason.replace(/</g, '&lt;');
                    subRow.appendChild(cell);
                    row.parentNode.insertBefore(subRow, row.nextSibling);
                });

                if (reasonObserver) reasonObserver.observe(table, { childList: true, subtree: true });
            }

            function setupReasonObserver() {
                var container = document.getElementById('mailq-grid');
                reasonObserver = new MutationObserver(function(mutations) {
                    for (var i = 0; i < mutations.length; i++) {
                        var m = mutations[i];
                        if (m.type === 'childList') {
                            var shouldUpdate = false;
                            m.addedNodes.forEach(function(n) {
                                if (n.nodeType !== 1) return;
                                if (n.tagName === 'TBODY' || n.tagName === 'TR') shouldUpdate = true;
                                if (n.querySelector) {
                                    if (n.querySelector('tr:not(.reason-subrow)')) shouldUpdate = true;
                                }
                            });
                            m.removedNodes.forEach(function(n) {
                                if (n.nodeType !== 1) return;
                                if (n.tagName === 'TBODY' || n.tagName === 'TR') shouldUpdate = true;
                            });
                            if (shouldUpdate) {
                                insertReasonSubRows();
                                break;
                            }
                        }
                    }
                });
                var checkTable = function() {
                    var table = container.querySelector('.gridjs-table');
                    if (table) {
                        reasonObserver.observe(table, { childList: true, subtree: true });
                        insertReasonSubRows();
                    } else {
                        setTimeout(checkTable, 200);
                    }
                };
                setTimeout(checkTable, 200);
            }

            function doCustomSearch() {
                var q = customSearchInput.value.toLowerCase();
                if (!q) {
                    filteredData = allData.slice();
                } else {
                    filteredData = allData.filter(function(row) {
                        for (var ci = 1; ci < row.length - 2; ci++) {
                            if (String(row[ci]).toLowerCase().indexOf(q) !== -1) return true;
                        }
                        return false;
                    });
                }
                renderGrid();
            }

            customSearchInput.addEventListener('input', doCustomSearch);

            document.getElementById('btn-csv').addEventListener('click', function() {
                var rows = grid ? grid.config.data : filteredData;
                var header = ['File','Recipients','Sender','Subject','Score','Spam Detail','Date/Time','ClientIP','DKIM'];
                var csv = header.join(',') + '\\n';
                rows.forEach(function(r) {
                    var vals = [r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8]];
                    var esc = vals.map(function(c) { return '"' + String(c).replace(/"/g, '""') + '"'; });
                    csv += esc.join(',') + '\\n';
                });
                var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                var link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'MailQueue.csv';
                link.click();
                URL.revokeObjectURL(link.href);
            });

            document.getElementById('btn-copy').addEventListener('click', function() {
                var rows = grid ? grid.config.data : filteredData;
                var header = ['Recipients','Sender','Subject','Score','Spam Detail','Date/Time','ClientIP','DKIM'];
                var pad = [22, 30, 40, 8, 18, 20, 16, 10];
                function fmtRow(arr) {
                    var vals = [arr[1], arr[2], arr[3], arr[4], arr[5], arr[6], arr[7], arr[8]];
                    return vals.map(function(c, i) { return String(c).padEnd(pad[i] || 20).slice(0, pad[i] || 20); }).join(' | ');
                }
                var text = fmtRow(header) + '\\n' + '-'.repeat(fmtRow(header).length) + '\\n';
                text += rows.map(fmtRow).join('\\n');
                navigator.clipboard.writeText(text).then(function() {
                    var btn = document.getElementById('btn-copy');
                    var orig = btn.innerHTML;
                    btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                    setTimeout(function() { btn.innerHTML = orig; }, 2000);
                });
            });

            document.getElementById('btn-print').addEventListener('click', function() {
                var rows = grid ? grid.config.data : filteredData;
                var win = window.open('', '_blank');
                var html = '<!DOCTYPE html><html><head><title>Mail Queue</title>';
                html += '<style>body{font-family:Roboto,sans-serif;margin:20px;}';
                html += 'h2{color:#1e293b;}table{border-collapse:collapse;width:100%;font-size:12px;}';
                html += 'th{background:#1976d2;color:#fff;padding:8px 10px;text-align:left;font-size:11px;text-transform:uppercase;}';
                html += 'td{padding:6px 10px;border-bottom:1px solid #e2e8f0;}tr:nth-child(even){background:#fafafa;}</style></head><body>';
                html += '<h2>Mail Queue</h2><table><thead><tr>';
                html += '<th>Recipients</th><th>Sender</th><th>Subject</th><th>Score</th><th>Spam Detail</th><th>Date/Time</th><th>ClientIP</th><th>DKIM</th>';
                html += '</tr></thead><tbody>';
                rows.forEach(function(r) {
                    html += '<tr><td>' + r[1] + '</td><td>' + r[2] + '</td><td>' + r[3] + '</td><td>' + r[4] + '</td><td>' + r[5] + '</td><td>' + r[6] + '</td><td>' + r[7] + '</td><td>' + r[8] + '</td></tr>';
                });
                html += '</tbody></table></body></html>';
                win.document.write(html);
                win.document.close();
                win.focus();
                win.print();
            });

            document.documentElement.addEventListener('click', function(e) {
                var btn = e.target.closest('.btn-whitelist, .btn-blacklist');
                if (btn && btn.closest('.mailq-grid-wrapper')) {
                    showSingleListingModal(btn);
                }
            });

            renderGrid();
            setupReasonObserver();
        });

