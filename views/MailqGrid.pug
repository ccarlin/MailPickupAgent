        }
        .mui-btn.mui-btn-success:hover {
            background: #059669;
            border-color: #059669;
            box-shadow: 0 2px 6px rgba(16,185,129,0.3);
        }
        .mui-btn.mui-btn-success:active {
            background: #047857;
        }
        .mui-btn.mui-btn-warning {
            background: #f59e0b;
