        }
        .mui-filters-row .mui-filters-right input:focus {
            border-color: #1976d2;
            box-shadow: 0 0 0 2px rgba(25,118,210,0.15);
        }
        .mui-select-all {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 0.7rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #64748b;
            cursor: pointer;
            user-select: none;
        }
        .mui-select-all input {
            accent-color: #1976d2;
            margin: 0;
        }
        .mui-btn-sep {
            width: 1px;
            height: 24px;
            background: #e2e8f0;
        }
        .mailq-grid-wrapper td a {
            color: #1976d2;
            text-decoration: none;
        }
        .mailq-grid-wrapper td a:hover {
            text-decoration: underline;
        }
        .mailq-grid-wrapper td .sender-danger {
