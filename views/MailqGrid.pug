    style.
        .mailq-grid-wrapper {
            font-family: 'Roboto', sans-serif;
            margin: 0.5rem 0;
        }
        .mailq-grid-wrapper .gridjs-container {
            font-family: 'Roboto', sans-serif;
            color: #1e293b;
        }
        .mailq-grid-wrapper .gridjs-head {
            display: none;
        }
        .mailq-grid-wrapper table {
            border-collapse: collapse;
            width: 100%;
            font-size: 0.8125rem;
        }
        .mailq-grid-wrapper td {
            overflow: visible !important;
            text-overflow: clip !important;
        }
        .mailq-grid-wrapper th {
            background: #1976d2;
            color: #fff;
            font-weight: 500;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 6px 8px;
