        }
        .mui-filters-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 20px;
            gap: 12px;
            flex-wrap: wrap;
        }
        .mui-filters-row .mui-filters-left {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }
        .mui-filters-row .mui-filters-right {
            display: flex;
            align-items: center;
        }
        .mui-filters-row .mui-filters-right input {
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            padding: 6px 12px;
