extends adminLayout

block css
  link(id="favicon" rel="icon" href="/img/MailPickupAgent.png" type="image/png" sizes="16x16")
  style.
    .status-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 1.5rem;
      margin: 0 auto;
    }
    .status-card {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      padding: 1.25rem;
      text-align: center;
      transition: transform 0.2s ease;
    }
    .status-card:hover {
      transform: translateY(-2px);
    }
    .status-card .icon {
      font-size: 2rem;
      margin-bottom: 0.5rem;
      min-height: 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .status-card .icon img {
      max-width: 10rem;
      max-height: 3rem;
      object-fit: contain;
    }
    .status-card .count {
      font-size: 2.2rem;
      font-weight: 700;
      color: #1e293b;
    }
    .status-card .label {
      font-size: 0.85rem;
      color: #64748b;
      letter-spacing: 0.05em;
      margin-top: 0.25rem;
    }
    .status-card.total .icon { color: #3b82f6; }
    .status-card.whitelisted .icon { color: #22c55e; }
    .status-card.blacklisted .icon { color: #ef4444; }
    .status-card.quarantined .icon { color: #f59e0b; }
    .status-card.released .icon { color: #10b981; }
    .status-card.deleted .icon { color: #64748b; }
    .status-card.uptime .icon { color: #8b5cf6; }
    .status-card.pending .icon { color: #f97316; }
    .status-card.users .icon { color: #06b6d4; }
    .status-card.notifications .icon { color: #a855f7; }
    .status-card.process-time .icon { color: #0ea5e9; }

    .status-card .icon-wrap {
      position: relative;
      display: inline-block;
    }
    .status-card .icon-badge {
      position: absolute;
      top: -6px;
      right: -12px;
      background: #ef4444;
      color: #fff;
      font-size: 0.65rem;
      font-weight: 700;
      min-width: 18px;
      height: 18px;
      line-height: 18px;
      border-radius: 10px;
      padding: 0 4px;
      text-align: center;
      box-shadow: 0 0 0 2px #fff;
      display: none;
    }
    .status-card .icon-badge.show {
      display: inline-block;
    }

    .status-card.uptime .count {
      font-size: 1.4rem;
    }

    .status-card.clickable {
      cursor: pointer;
    }
    .status-card.clickable:hover {
      box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    }

    .status-card.pending.alert {
      background: #fff7ed;
      border: 2px solid #f97316;
      animation: pulse-alert 2s ease-in-out infinite;
    }
    @keyframes pulse-alert {
      0%, 100% { box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.4); }
      50% { box-shadow: 0 0 0 12px rgba(249, 115, 22, 0); }
    }

    .status-card .test-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: #e0f2fe;
      color: #0369a1;
      font-size: 0.65rem;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 8px;
      margin-top: 0.5rem;
      letter-spacing: 0.04em;
    }
    .status-card .test-badge i {
      font-size: 0.55rem;
    }

    .status-card.service-up .icon { color: #22c55e; }
    .status-card.service-down .icon { color: #ef4444; }
    .status-card.service-up .count { color: #16a34a; font-size: 1rem; }
    .status-card.service-down .count { color: #dc2626; font-size: 1rem; }
    .status-card.abuseipdb .icon { color: #f59e0b; }
    .status-card.abuseipdb.configured .icon { color: #22c55e; }
    .status-card.abuseipdb.not-configured .icon { color: #94a3b8; }
    .status-card.abuseipdb.configured .count { color: #16a34a; font-size: 1rem; }
    .status-card.abuseipdb.not-configured .count { color: #94a3b8; font-size: 1rem; }
    .status-card.process-time .icon { color: #0ea5e9; }
    .status-card.hidden { display: none; }

    #server-offline {
      display: none;
      text-align: center;
      padding: 3rem 1rem;
      margin: 2rem 0;
      border: 3px solid #ef4444;
      border-radius: 12px;
      background: #fef2f2;
    }
    #server-offline h1 {
      font-size: 3rem;
      font-weight: 900;
      color: #dc2626;
      margin: 0 0 0.5rem 0;
      text-transform: uppercase;
    }
    #server-offline p {
      font-size: 1.1rem;
      color: #991b1b;
    }

    #status-content {
      display: block;
    }

    #status-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      min-height: 2rem;
    }
    #status-header .header-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .last-update {
      font-size: 0.8rem;
      color: #94a3b8;
    }

    .connection-status {
      font-size: 0.8rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .connection-status .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }
    .connection-status .dot.connected { background: #22c55e; }
    .connection-status .dot.disconnected { background: #ef4444; }
    .connection-status .dot.connecting { background: #f59e0b; }

    .status-card.purge-on .icon { color: #22c55e; }
    .status-card.purge-off .icon { color: #94a3b8; }
    .status-card.purge-on .count { color: #16a34a; font-size: 0.9rem; }
    .status-card.purge-off .count { color: #94a3b8; font-size: 0.9rem; }
    .status-card .sub-label {
      font-size: 0.7rem;
      color: #94a3b8;
      margin-top: 0.15rem;
    }

    .highlight-flash {
      animation: highlight-flash 1s ease-out;
    }
    @keyframes highlight-flash {
      0% { background: #dbeafe; }
      100% { background: #fff; }
    }

    .reset-stats-btn {
      background: none;
      border: 1px solid #e2e8f0;
      color: #ef4444;
      padding: 4px 12px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.8rem;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .reset-stats-btn:hover {
      background: #fef2f2;
      border-color: #fca5a5;
    }

    #ai-test-modal,
    #sa-test-modal,
    #abuseipdb-test-modal {
      display: none;
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      background: rgba(0,0,0,0.7);
      z-index: 1000;
      justify-content: center;
      align-items: center;
    }
    #ai-test-modal.show,
    #sa-test-modal.show,
    #abuseipdb-test-modal.show { display: flex; }
    #ai-test-modal .modal-box,
    #sa-test-modal .modal-box,
    #abuseipdb-test-modal .modal-box {
      background: #fff;
      border-radius: 12px;
      padding: 1.5rem;
      max-width: 900px;
      width: 95%;
      max-height: 80vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 8px 32px rgba(0,0,0,0.25);
    }
    #ai-test-modal .modal-box h2,
    #sa-test-modal .modal-box h2,
    #abuseipdb-test-modal .modal-box h2 {
      margin: 0 0 1rem 0;
      font-size: 1.25rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    #ai-test-modal .modal-box pre,
    #sa-test-modal .modal-box pre,
    #abuseipdb-test-modal .modal-box pre {
      flex: 1;
      overflow: auto;
      background: #1e293b;
      color: #e2e8f0;
      padding: 1rem;
      border-radius: 8px;
      font-size: 0.85rem;
      white-space: pre;
      min-height: 200px;
      margin: 0;
    }
    #ai-test-modal .modal-box .modal-footer,
    #sa-test-modal .modal-box .modal-footer,
    #abuseipdb-test-modal .modal-box .modal-footer {
      display: flex;
      justify-content: flex-end;
      margin-top: 1rem;
    }
    #ai-test-modal .modal-box .modal-footer button,
    #sa-test-modal .modal-box .modal-footer button,
    #abuseipdb-test-modal .modal-box .modal-footer button {
      background: #3b82f6;
      color: #fff;
      border: none;
      padding: 8px 20px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.9rem;
    }
    #ai-test-modal .modal-box .modal-footer button:hover,
    #sa-test-modal .modal-box .modal-footer button:hover,
    #abuseipdb-test-modal .modal-box .modal-footer button:hover {
      background: #2563eb;
    }

block content
  #server-offline
    h1 &#9888; Server Offline
    p The server is no longer responding. Check the service status.

  #status-content
    #status-header
      .header-left
        .connection-status
          span.dot#connection-dot.connecting
          span#connection-text Connecting...
        .last-update
          | Last updated: <span id="last-update-time">--</span>
      button.reset-stats-btn#btn-reset-stats(title="Reset all metrics to zero")
        i.fas.fa-undo-alt
        | Reset Stats
    .status-grid
      .status-card.total.clickable#card-total
        .icon
          i.fas.fa-envelope
        .count#count-total 0
        .label Total Processed
        .sub-label (since last restart)
      .status-card.process-time#card-process-time
        .icon
          i.fas.fa-tachometer-alt
        .count#count-process-time N/A
        .label Avg Process Time
        .sub-label#sub-process-time (0 checks)
      .status-card.pending.clickable#card-pending
        .icon
          .icon-wrap
            i.fas.fa-inbox
            span.icon-badge#badge-pending 0
        .count#count-pending 0
        .label Mail Queue
      .status-card.quarantined.clickable#card-quarantined
        .icon
          i.fas.fa-shield-alt
        .count#count-quarantined 0
        .label Quarantined
        .sub-label (since last restart)
      .status-card.whitelisted.clickable#card-whitelisted
        .icon
          i.fas.fa-check-circle
        .count#count-whitelisted 0
        .label Whitelisted
        .sub-label (since last restart)
      .status-card.blacklisted.clickable#card-blacklisted
        .icon
          i.fas.fa-ban
        .count#count-blacklisted 0
        .label Blacklisted
        .sub-label (since last restart)
      .status-card.released.clickable#card-released
        .icon
          i.fas.fa-paper-plane
        .count#count-released 0
        .label Released
        .sub-label (since last restart)
      .status-card.deleted.clickable#card-deleted
        .icon
          i.fas.fa-trash-alt
        .count#count-deleted 0
        .label Deleted
        .sub-label (since last restart)
      .status-card.service-down.hidden.clickable#card-ai
        .icon
          - var aiLogo = aiSystem === 'LLAMACPP' ? '/img/llamacpp-logo.svg' : '/img/ollama-logo.svg'
          img(src=aiLogo, alt="AI Check")
        .count#count-ai
          i.fas.fa-times-circle
          |  Offline
        .label#label-ai AI Check
        .sub-label#sub-ai-time
        .test-badge
          i.fas.fa-play
          |  Clicking card runs test
      .status-card.service-down.hidden.clickable#card-sa
        .icon
          img(src="/img/spamassassin.svg" alt="SpamAssassin")
        .count#count-sa
          i.fas.fa-times-circle
          |  Offline
        .label SpamAssassin
        .sub-label#sub-sa-time
        .test-badge
          i.fas.fa-play
          |  Clicking card runs test
      .status-card.abuseipdb.not-configured.hidden.clickable#card-abuseipdb
        .icon
          img(src="/img/abuseipdb-logo.svg" alt="AbuseIPDB")
        .count#count-abuseipdb
          i.fas.fa-times-circle
          |  Not Configured
        .label AbuseIPDB
        .sub-label#sub-abuseipdb-time
        .test-badge
          i.fas.fa-play
          |  Clicking card runs test
      .status-card.uptime
        .icon
          i.fas.fa-clock
        .count#count-uptime 0
        .label Uptime
        .sub-label (since last restart)
      .status-card.users.clickable#card-users
        .icon
          i.fas.fa-users
        .count#count-users 0
        .label Logged In Users
      .status-card.notifications.clickable#card-notifications
        .icon
          i.fas.fa-bell
        .count#count-notifications 0
        .label Notifications
      .status-card.purge-off.clickable#card-purge
        .icon
          i.fas.fa-broom
        .count#count-purge OFF
        .label Auto Purge 
        .sub-label#purge-on-message (runs while page is open)
        .sub-label#purge-last-run

  #ai-test-modal
    .modal-box
      h2
        i.fas.fa-brain
        | AI Check Test
      pre#ai-test-output Running AI test...
      .modal-footer
        button(onclick="$('#ai-test-modal').removeClass('show')") Close

  #sa-test-modal
    .modal-box
      h2
        i.fas.fa-shield-halved
        | SpamAssassin Test
      pre#sa-test-output Running SpamAssassin test...
      .modal-footer
        button(onclick="$('#sa-test-modal').removeClass('show')") Close

  #abuseipdb-test-modal
    .modal-box
      h2
        i.fas.fa-globe
        | AbuseIPDB Test
      pre#abuseipdb-test-output Running AbuseIPDB test...
      .modal-footer
        button(onclick="$('#abuseipdb-test-modal').removeClass('show')") Close

block scripts
  script(src="https://cdn.jsdelivr.net/npm/jquery@4.0.0/dist/jquery.min.js")
  script.
    function formatMs(ms) {
      if (ms === null) return 'N/A';
      return ms >= 1000 ? (ms / 1000).toFixed(1) + 's' : ms + 'ms';
    }

    function updateUI(data) {
      $('#count-total').text(data.totalProcessed);
      $('#count-whitelisted').text(data.whitelisted);
      $('#count-blacklisted').text(data.blacklisted);
      $('#count-quarantined').text(data.quarantined);
      $('#badge-pending').text(data.pending).toggleClass('show', data.pending > 0);
      $('#count-released').text(data.released);
      $('#count-deleted').text(data.deleted);
      $('#count-uptime').text(data.uptimeFormatted);
      $('#count-users').text(data.loggedInUsers);
      $('#count-pending').text(data.pending);
      $('#card-pending').toggleClass('alert', data.pending > 0);
      if (data.aiEnabled) {
        $('#label-ai').text('AI Check (' + data.aiSystem + ')');
        $('#card-ai .icon img').attr('src', data.aiSystem === 'LLAMACPP' ? '/img/llamacpp-logo.svg' : '/img/ollama-logo.svg');
        $('#card-ai').removeClass('hidden').toggleClass('service-up service-down', data.aiRunning);
        $('#count-ai').html(data.aiRunning
          ? '<i class="fas fa-check-circle" style="color:#16a34a"></i> <span style="color:#16a34a">Running</span>'
          : '<i class="fas fa-times-circle" style="color:#dc2626"></i> <span style="color:#dc2626">Offline</span>');
        if (data.aiAvgTime !== undefined) {
          $('#sub-ai-time').text('Avg: ' + formatMs(data.aiAvgTime) + ' (' + data.aiCheckCount + ' checks)');
        }
      } else {
        $('#card-ai').addClass('hidden');
      }
      if (data.saEnabled) {
        $('#card-sa').removeClass('hidden').toggleClass('service-up service-down', data.saRunning);
        $('#count-sa').html(data.saRunning
          ? '<i class="fas fa-check-circle" style="color:#16a34a"></i> <span style="color:#16a34a">Running</span>'
          : '<i class="fas fa-times-circle" style="color:#dc2626"></i> <span style="color:#dc2626">Offline</span>');
        if (data.saAvgTime !== undefined) {
          $('#sub-sa-time').text('Avg: ' + formatMs(data.saAvgTime) + ' (' + data.saCheckCount + ' checks)');
        }
      } else {
        $('#card-sa').addClass('hidden');
      }
      if (data.abuseipdbEnabled) {
        $('#card-abuseipdb').removeClass('hidden').toggleClass('configured not-configured', true);
        $('#count-abuseipdb').html('<i class="fas fa-check-circle" style="color:#16a34a"></i> <span style="color:#16a34a">Configured</span>');
        if (data.abuseipdbAvgTime !== undefined) {
          $('#sub-abuseipdb-time').text('Avg: ' + formatMs(data.abuseipdbAvgTime) + ' (' + data.abuseipdbCheckCount + ' checks)');
        }
      } else {
        $('#card-abuseipdb').addClass('hidden');
      }
      $('#count-notifications').text(data.notificationCount);
      if (data.avgProcessTime !== undefined) {
        $('#count-process-time').text(formatMs(data.avgProcessTime));
        $('#sub-process-time').text('(' + data.processCount + ' emails)');
      }
      $('#last-update-time').text(new Date().toLocaleTimeString());
      $('#server-offline').hide();
      $('#status-content').show();
      changeIcon(data.pending);
    }

    function updateMetricUI(data) {
      if (data.totalProcessed !== undefined) $('#count-total').text(data.totalProcessed);
      if (data.whitelisted !== undefined) $('#count-whitelisted').text(data.whitelisted);
      if (data.blacklisted !== undefined) $('#count-blacklisted').text(data.blacklisted);
      if (data.quarantined !== undefined) $('#count-quarantined').text(data.quarantined);
      if (data.released !== undefined) $('#count-released').text(data.released);
      if (data.deleted !== undefined) $('#count-deleted').text(data.deleted);
      if (data.pending !== undefined) {
        $('#badge-pending').text(data.pending).toggleClass('show', data.pending > 0);
        $('#count-pending').text(data.pending);
        $('#card-pending').toggleClass('alert', data.pending > 0);
        changeIcon(data.pending);
      }
      if (data.uptimeFormatted !== undefined) $('#count-uptime').text(data.uptimeFormatted);
      if (data.aiAvgTime !== undefined) {
        $('#sub-ai-time').text('Avg: ' + formatMs(data.aiAvgTime) + ' (' + data.aiCheckCount + ' checks)');
      }
      if (data.saAvgTime !== undefined) {
        $('#sub-sa-time').text('Avg: ' + formatMs(data.saAvgTime) + ' (' + data.saCheckCount + ' checks)');
      }
      if (data.abuseipdbAvgTime !== undefined) {
        $('#sub-abuseipdb-time').text('Avg: ' + formatMs(data.abuseipdbAvgTime) + ' (' + data.abuseipdbCheckCount + ' checks)');
      }
      if (data.avgProcessTime !== undefined) {
        $('#count-process-time').text(formatMs(data.avgProcessTime));
        $('#sub-process-time').text('(' + data.processCount + ' emails)');
      }
      $('#last-update-time').text(new Date().toLocaleTimeString());

      // Highlight the changed cards
      $('.status-card .count').filter(function() {
        return $(this).text() !== $(this).data('prev');
      }).each(function() {
        $(this).data('prev', $(this).text());
        $(this).closest('.status-card').addClass('highlight-flash');
        setTimeout(() => $(this).closest('.status-card').removeClass('highlight-flash'), 1000);
      });
    }

    let autoPurgeTimer = null;

    function updatePurgeCard(enabled) {
      if (enabled) {
        $('#card-purge').removeClass('purge-off').addClass('purge-on');
        $('#count-purge').html('<i class="fas fa-check-circle" style="color:#16a34a"></i> ON');
        $('#purge-on-message').text('(runs while page is open)');
      } else {
        $('#card-purge').removeClass('purge-on').addClass('purge-off');
        $('#count-purge').html('<i class="fas fa-times-circle" style="color:#94a3b8"></i> OFF');
        $('#purge-on-message').text('(click to enable)');
      }
      const lastRun = localStorage.getItem('purgeLastRun');
      $('#purge-last-run').text(lastRun ? 'Last: ' + lastRun : '');
    }

    function runPurge() {
      $.post('/status/api/purge').done(function() {
        const now = new Date().toLocaleString();
        localStorage.setItem('purgeLastRun', now);
        updatePurgeCard(true);
      });
    }

    function startAutoPurge() {
      stopAutoPurge();
      autoPurgeTimer = setInterval(runPurge, 21600000);
    }

    function stopAutoPurge() {
      if (autoPurgeTimer) {
        clearInterval(autoPurgeTimer);
        autoPurgeTimer = null;
      }
    }

    function togglePurge() {
      const wasOn = localStorage.getItem('autoPurge') === 'true';
      if (wasOn) {
        localStorage.setItem('autoPurge', 'false');
        stopAutoPurge();
        updatePurgeCard(false);
      } else {
        localStorage.setItem('autoPurge', 'true');
        runPurge();
        startAutoPurge();
        updatePurgeCard(true);
      }
    }

    function changeIcon(emailCount) {
      if (emailCount < 1) {
        var oldLink = document.getElementById('favicon');
        if (oldLink) document.head.removeChild(oldLink);
        var link = document.createElement('link');
        link.id = 'favicon';
        link.rel = 'shortcut icon';
        link.href = '/img/MailPickupAgent.png';
        document.head.appendChild(link);
        return;
      }

      var canvas = document.createElement('canvas');
      canvas.width = 16;
      canvas.height = 16;
      var context = canvas.getContext('2d');

      var img = new Image();
      img.onload = function() {
        context.drawImage(img, 0, 0, 16, 16);
        context.beginPath();
        context.arc(16 - 16 / 3, 16 / 3, 16 / 3, 0, 2 * Math.PI);
        context.fillStyle = '#FF0000';
        context.fill();
        context.font = '10px "helvetica", sans-serif';
        context.textAlign = 'center';
        context.textBaseline = 'middle';
        context.fillStyle = '#FFFFFF';
        context.fillText(emailCount, 16 - 16 / 3, 16 / 3);

        var oldLink = document.getElementById('favicon');
        if (oldLink) document.head.removeChild(oldLink);
        var link = document.createElement('link');
        link.id = 'favicon';
        link.rel = 'shortcut icon';
        link.href = canvas.toDataURL('image/png');
        document.head.appendChild(link);
      };
      img.src = '/img/MailPickupAgent.png';
    }

    function setConnectionState(state) {
      var dot = $('#connection-dot');
      var text = $('#connection-text');
      dot.removeClass('connected disconnected connecting');
      if (state === 'connected') {
        dot.addClass('connected');
        text.text('Connected');
      } else if (state === 'disconnected') {
        dot.addClass('disconnected');
        text.text('Disconnected');
      } else {
        dot.addClass('connecting');
        text.text('Connecting...');
      }
    }

    $(document).ready(function() {
      var eventSource = new EventSource('/status/events');
      var connectTimeout = null;

      eventSource.addEventListener('full', function(e) {
        var data = JSON.parse(e.data);
        updateUI(data);
        // Store current values for change detection
        $('.status-card .count').each(function() {
          $(this).data('prev', $(this).text());
        });
        clearConnectTimeout();
        setConnectionState('connected');
      });

      eventSource.addEventListener('update', function(e) {
        var data = JSON.parse(e.data);
        updateMetricUI(data);
        clearConnectTimeout();
        setConnectionState('connected');
      });

      function clearConnectTimeout() {
        if (connectTimeout) {
          clearTimeout(connectTimeout);
          connectTimeout = null;
        }
      }

      function startConnectTimeout() {
        if (connectTimeout) return;
        connectTimeout = setTimeout(function() {
          setConnectionState('disconnected');
          $('#server-offline').show();
          $('#status-content').hide();
        }, 15000);
      }

      eventSource.onerror = function() {
        if (eventSource.readyState === EventSource.CONNECTING) {
          setConnectionState('connecting');
          startConnectTimeout();
        } else {
          clearConnectTimeout();
          setConnectionState('disconnected');
          $('#server-offline').show();
          $('#status-content').hide();
        }
      };

      eventSource.onopen = function() {
        clearConnectTimeout();
        setConnectionState('connected');
        $('#server-offline').hide();
        $('#status-content').show();
      };

