block content
    script.    
        $(document).ready(function () {     
            var timeout = setTimeout("location.reload(true);", 600000);
            $('#chkSelectAll').click(function ()
            {
                $('input:checkbox').not(this).prop('checked', this.checked);
            });
            changeIcon();
            var table = $('#GridView1').DataTable({
                 order: [[ 6, "asc" ]],  
                 paging: false,
                 info: false,
                 language: {"emptyTable": "Nothing to see here move along.",  "zeroRecords": "No matches found."}                 
            });             
        });      

        function ConfirmFunction(action) {           
            if (action == 'clear')
            {
               $('#chkSelectAll').click();
               action = 'remove';
            }

            var selectCount = $("table[id*=GridView1] input[type=checkbox][id*=chkItem]:checked").length;
            if (selectCount > 0)
            {
                var msg = "Are you sure you wish to " + action + " " + selectCount + " email(s)?";
                return confirm(msg);
            }            
            else
            {
                alert("Please select one or more messages.");
                return false;
            }
        };
       
        function closePreviewModal() {
            $('#emailPreviewModal').hide();
            $('#emailPreviewFrame').attr('src', '');
        }

        $(document).on('click', '.preview-link', function (e) {
            e.preventDefault();
            var key = $(this).data('mailkey');
            var view = $(this).data('view');
            if (!key) return;
            var url = view === 'html' ? 'emailPreview?view=HTML&mailKey=' + encodeURIComponent(key) : 'emailPreview?mailKey=' + encodeURIComponent(key);
            $('#emailPreviewFrame').attr('src', url);
            $('#emailPreviewModal').show();
        });

        var pendingAction = null;
        var pendingItems = [];

        function showBatchListingModal(action) {
            $('#mainForm').find('input.dynamic-action').remove();

            var selectCount = $("table[id*=GridView1] input[type=checkbox][id*=chkItem]:checked").length;
            if (selectCount === 0) {
                alert("Please select one or more messages.");
                return;
            }

            pendingAction = action;
            pendingItems = [];

            $("table[id*=GridView1] input[type=checkbox][id*=chkItem]:checked").each(function() {
                var $row = $(this).closest('tr');
                var sender = $row.find('td:nth-child(3)').text().trim();
                pendingItems.push({ sender: sender });
            });

            $('#listingModalTitle').text((action === 'whitelist' ? 'Whitelist' : 'Blacklist') + ' Senders');
            renderListingPreview();
            $('#listingModal').show();
        }

        function showSingleListingModal(btn) {
            var $btn = $(btn);
            var action = $btn.hasClass('btn-blacklist') ? 'blacklist' : 'whitelist';
            var rawKey = $btn.attr('data-mailkey') || '';
            var filepath = rawKey ? decodeURIComponent(rawKey) : '';
            if (!filepath) return;

            pendingAction = action;
            pendingItems = [];

            var $row = $btn.closest('tr');
            var sender = $row.find('td:nth-child(3)').text().trim();
            pendingItems.push({
                filepath: filepath,
                sender: sender,
                _btn: $btn,
                subject: $row.find('td:nth-child(4)').text().trim(),
                recipients: $row.find('td:nth-child(2)').text().trim(),
                spamScore: $row.find('td:nth-child(5)').text().trim(),
                antiSpam: $row.find('td:nth-child(6)').text().trim(),
                datetime: $row.find('td:nth-child(7)').text().trim(),
                dkim: $row.find('td:nth-child(9)').text().trim()
            });

            $('#listingModalTitle').text((action === 'whitelist' ? 'Whitelist' : 'Blacklist') + ' Sender');
            renderListingPreview();
            $('#listingModal').show();
        }

        function renderListingPreview() {
            var isDomain = $('input[name="listTypeChoice"]:checked').val() === 'domain';
            var seen = {};
            var $list = $('#listingAddressList').empty();
            pendingItems.forEach(function(item) {
                var display = isDomain ? extractDomain(item.sender) : item.sender;
                if (!seen[display]) {
                    seen[display] = true;
                    $('<div>').text(display).appendTo($list);
                }
            });
        }

        function extractDomain(email) {
            var atIndex = email.lastIndexOf('@');
            if (atIndex !== -1) return '@' + email.slice(atIndex + 1);
            return email;
        }

        function confirmListing() {
            var isDomain = $('input[name="listTypeChoice"]:checked').val() === 'domain';
            $('#listingModal').hide();

            document.getElementById('listType').value = isDomain ? 'domain' : 'email';

            if (pendingItems.length === 1 && pendingItems[0]._btn) {
                performSingleAction(pendingAction, pendingItems[0], isDomain ? 'domain' : 'email');
            } else {
                var mainForm = document.getElementById('mainForm');
                var old = mainForm.querySelector('input.dynamic-action');
                if (old) old.remove();
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'action';
                input.value = pendingAction;
                input.className = 'dynamic-action';
                mainForm.appendChild(input);
                mainForm.submit();
            }

            pendingAction = null;
            pendingItems = [];
        }

        function closeListingModal() {
            $('#listingModal').hide();
            pendingAction = null;
            pendingItems = [];
        }

        function performSingleAction(action, item, listType) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '/mailq/action';
            form.style.display = 'none';

            function addField(name, value) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = value;
                form.appendChild(input);
            }

            addField('action', action);
            addField('filePath', item.filepath);
            addField('subject', item.subject);
            addField('sender', item.sender);
            addField('recipients', item.recipients);
            addField('spamScore', item.spamScore);
            addField('antiSpam', item.antiSpam);
            addField('clientip', '');
            addField('datetime', item.datetime);
            addField('dkim', item.dkim);
            addField('listType', listType);

            document.body.appendChild(form);
            form.submit();
        }

        function changeIcon() { 
            var emailCount = $("table[id*=GridView1] input[type=checkbox]").length - 1;        
            //Reset to normal if no emails..
            if (emailCount < 1)
            {            
                var link = document.createElement('link');
                var oldLink = document.getElementById('favicon');
                link.id = 'favicon';
                link.rel = 'shortcut icon';
                link.href = 'img/MailPickupAgent.png';
                if (oldLink)
                    document.head.removeChild(oldLink);            
                document.head.appendChild(link);
                                 
                return;
            }

            var favicon = document.getElementById('favicon');
            var faviconSize = 16;

            var canvas = document.createElement('canvas');
            canvas.width = faviconSize;
            canvas.height = faviconSize;

            var context = canvas.getContext('2d');
            var img = document.createElement('img');
            img.src = favicon.href;

            img.onload = () => {
                // Draw Original Favicon as Background
                context.drawImage(img, 0, 0, faviconSize, faviconSize);
                        
                // Draw Notification Circle
                context.beginPath();
                context.arc( canvas.width - faviconSize / 3 , faviconSize / 3, faviconSize / 3, 0, 2*Math.PI);
                context.fillStyle = '#FF0000';
                context.fill();

                // Draw Notification Number
                context.font = '10px "helvetica", sans-serif';
                context.textAlign = "center";
                context.textBaseline = "middle";
                context.fillStyle = '#FFFFFF';
                context.fillText(emailCount, canvas.width - faviconSize / 3, faviconSize / 3);

                // Replace favicon
                favicon.href = canvas.toDataURL('image/png');           
            };
        }
        
    form#mainForm(action='/mailq', method="POST")        
        table(style='width: 100%')
            tr
                td(align="left")
                    input#butDeleteAll(type='submit' name='action' value='Delete All' onclick="return ConfirmFunction('clear');" class="myMiniButton")
                    input#butDelete(type='submit' name='action' value='Delete' onclick="return ConfirmFunction('remove');" class="myMiniButton")
                    input#butRelease(type='submit' name='action' value='Release' onclick="return ConfirmFunction('release');" class="myMiniButton")
                    input#butWhitelist(type='button' value='Whitelist' onclick="showBatchListingModal('whitelist');" class="myMiniButton")
                    input#butBlacklist(type='button' value='Blacklist' onclick="showBatchListingModal('blacklist');" class="myMiniButton")
                    input(type='hidden' name='listType' id='listType')
                    // Clear filter button: shown when server indicates a filter is active
                    if filterUser
                        input(type='submit' name='action' value='Filter Clear' class='myMiniButton' onclick="return confirm('Clear MailQ user filter?');")
                td(align="right")                
                    | #{currentTime}        
        div
            table#GridView1(class="row-border compact order-column hover stripe" style='width: 100%; font-size: small')
                thead
                    th(scope='col')
                        input#chkSelectAll(type='checkbox')
                    th(scope='col') Recipients
                    th(scope='col') Sender
                    th(scope='col') Subject
                    th(scope='col') Score 
                    th(scope='col') Reason
                    th(scope='col') Date/Time
                    th(scope='col') ClientIP
                    th(scope='col') DKIM
                    th(scope='col') Actions
                each email, idx in emails
                    tr(title=email.clientipinfo)
                        td
                            - var uniqueId = 'GridView1_chkItem_' + idx;
                            input(type='checkbox' id=uniqueId name=email.filepath)
                        td #{email.recipients}
                        if email.safe
                            td #{email.sender}
                        else
                            td(style='color: red;font-weight:bold;') #{email.sender}
                        td #{email.subject}
                        td #{isNaN(Number(email.spamScore)) ? email.spamScore : Number(email.spamScore).toFixed(1)}
                        td #{email.antiSpam}
                        td #{email.date}
                        td
                            a(href=`https://www.ipqualityscore.com/ip-reputation-check/lookup/${email.clientip}`, target='_blank') #{email.clientip}
                        td #{email.dkim}
                        td(style="white-space: nowrap;")
                            button.btn.btn-preview.preview-link(type="button" data-mailkey=email.filepath data-view="text" title="Plain Text Preview")
                                i.material-icons article
                            if (email.safe)
                                |&nbsp;
                                button.btn.btn-preview.preview-link(type="button" data-mailkey=email.filepath data-view="html" title="HTML Preview")
                                    i.material-icons visibility
                            |&nbsp;
                            button.btn.btn-whitelist(type="button" title="Whitelist Sender" onclick="showSingleListingModal(this)" data-mailkey=encodeURIComponent(email.filepath))
                                i.material-icons check_circle
                            |&nbsp;
                            button.btn.btn-blacklist(type="button" title="Blacklist Sender" onclick="showSingleListingModal(this)" data-mailkey=encodeURIComponent(email.filepath))
                                i.material-icons block
                            input(type='hidden' name='data[' + email.filepath + '][subject]' value=email.subject)
                            input(type='hidden' name='data[' + email.filepath + '][sender]' value=email.sender)
                            input(type='hidden' name='data[' + email.filepath + '][recipients]' value=email.recipients)
                            input(type='hidden' name='data[' + email.filepath + '][spamScore]' value=email.spamScore)
                            input(type='hidden' name='data[' + email.filepath + '][antiSpam]' value=email.antiSpam)
                            input(type='hidden' name='data[' + email.filepath + '][clientip]' value=email.clientip)
                            input(type='hidden' name='data[' + email.filepath + '][datetime]' value=email.date)
                            input(type='hidden' name='data[' + email.filepath + '][dkim]' value=email.dkim)
        
    #listingModal.preview-modal
        .listing-modal-content
            div(style="display:flex; justify-content:space-between; align-items:center;")
                h2#listingModalTitle
                button(type="button" onclick="closeListingModal()" style="background:transparent;border:none;font-size:1.5rem;cursor:pointer;") &times;
            div(style="margin:14px 0;")
                label(style="margin-right:20px;cursor:pointer;")
                    input(type="radio" name="listTypeChoice" value="email" checked onchange="renderListingPreview()")
                    | &nbsp;Full Email Address
                label(style="cursor:pointer;")
                    input(type="radio" name="listTypeChoice" value="domain" onchange="renderListingPreview()")
                    | &nbsp;Domain Only
            div(style="margin:12px 0;font-weight:bold;") The following will be added:
            div#listingAddressList(style="max-height:260px;overflow-y:auto;border:1px solid #ccc;padding:10px;border-radius:4px;font-family:monospace;font-size:0.9rem;background:#fafafa;")
            div(style="margin-top:18px;text-align:right;")
                button.myButton(type="button" onclick="confirmListing()" style="margin-right:8px;") Confirm
                button.myButton(type="button" onclick="closeListingModal()") Cancel

    #emailPreviewModal.preview-modal
        .preview-modal-content
            div(style="display:flex; justify-content:space-between; align-items:center;")
                h2 Email Preview
                button.myButton(onclick="closePreviewModal()") Close
            iframe#emailPreviewFrame
            