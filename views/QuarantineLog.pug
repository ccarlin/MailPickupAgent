    script(src="/scripts/jquery.sumoselect.min.js")
    script(src="/scripts/filtercontrol.js")

block content
    script.            
        $(document).ready(function ()
        {              
            var table = $('#myTable').DataTable({ 
                pageLength: 22,  
                order: [[0, "desc"]], 
                layout: {
                    topStart: { buttons: ['pageLength', 'copy', 'csv', 'excel', 'pdf', 'print'] },
                    topEnd: 'search',
                    bottomStart: 'info',
                    bottomEnd: 'paging'                
                },                          
                language: {"emptyTable": "Nothing to see here move along.",  "zeroRecords": "No matches found."},
                columnDefs: [ ], 
                initComplete: function () {
                    var btns = $('.dt-button');
                    btns.addClass('myMiniButton');
                    btns.removeClass('dt-button');   
                    [1].forEach(idx => standardFilterSetup(this.api().column(idx)));
                    [3].forEach(idx => multiFilterSetup(this.api().column(idx), 140));                                   
                 }
            });
        });  

    form
        table#myTable(class="row-border compact order-column hover stripe" style="font-size: small;")
            thead    
                th(align='left' scope='col') Time Stamp                    
                th(align='left' scope='col') Action
                th(align='left' scope='col') Sender
                th(align='left' scope='col') Recipient
                th(align='left' scope='col') Subject
                th(align='left' scope='col') Score
                th(align='left' scope='col') SPAM Results
                th(align='left' scope='col') IP Address
            each logEntry in logData
                tr
                    td #{logEntry.dateTime}
                    td #{logEntry.action}                                                
                    td #{logEntry.sender}
                    td #{logEntry.recipient}
                    td #{logEntry.subject}                    
                    td #{logEntry.spamScore} 
                    td #{logEntry.spamResults}
                    td #{logEntry.ipAddress}
            tfoot 
                tr
                    th 
                    th 
                    th
                    th
                    th
                    th
                    th
                    th                    