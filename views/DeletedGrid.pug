extends adminLayout

block css
    link(href="https://cdn.jsdelivr.net/npm/gridjs/dist/theme/mermaid.min.css" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet")
    link(href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet")
    style.
        .mui-btn.mui-btn-recover {
            background: #10b981;
            border-color: #10b981;
            color: #fff;
        }
        .mui-btn.mui-btn-recover:hover {
            background: #059669;
            border-color: #059669;
            box-shadow: 0 2px 6px rgba(16,185,129,0.3);
        }
        .mui-btn.mui-btn-recover:active {
            background: #047857;
        }
        .preview-btn {
            background: #6c757d;
            color: #fff;
            padding: 4px 6px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            font-size: 0.8rem;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            transition: background 0.15s;
        }
        .preview-btn:hover {
            background: #5a6268;
        }
        .preview-btn .material-icons {
            font-size: 14px;
        }
    link(id="favicon" rel="icon" href="/img/MailPickupAgent.png" type="image/png")

block scripts
    script(src="https://cdn.jsdelivr.net/npm/gridjs/dist/gridjs.umd.js")

block content
    script.
        document.addEventListener('DOMContentLoaded', function() {
            var emailData = !{JSON.stringify(emails).replace(/<\//g, '\\u003c/')};
            emailData.sort(function(a, b) {
                return (parseInt(b.timeAcquired) || 0) - (parseInt(a.timeAcquired) || 0);
            });
            var emailStore = {};
            var allData = emailData.map(function(e) {
                var score = isNaN(Number(e.spamScore)) ? e.spamScore : +Number(e.spamScore).toFixed(1);
                var time = e.timeAcquired ? new Date(parseInt(e.timeAcquired) * 1000).toLocaleString() : '';
                emailStore[e.filepath] = { sender: e.sender, recipients: e.recipients, subject: e.subject, spamScore: score, antiSpam: e.antiSpam, time: time };
                return [e.filepath, time, e.sender, e.recipients, e.subject, String(score), e.antiSpam, e.safe];
            });

            var grid = null;
            var filteredData = allData.slice();

            var filterConfig = [
                { idx: 3, label: 'Recipient', key: 'recipient' }
            ];

            var customSearchInput = document.getElementById('custom-search');
            document.getElementById('last-update').textContent = '#{currentTime}';

            setTimeout(function() { location.reload(true); }, 600000);

            function getDistinct(colIdx) {
                var set = {};
                allData.forEach(function(row) {
                    var v = (row[colIdx] || '').trim();
                    if (v) set[v] = true;
                });
                return Object.keys(set).sort(function(a, b) { return a.localeCompare(b); });
            }

            function buildMultiSelect(containerId, config) {
                var container = document.getElementById(containerId);
                var vals = getDistinct(config.idx);
                var html = '<div class="mui-multiselect" data-key="' + config.key + '">';
                html += '<button type="button" class="mui-multiselect-toggle" onclick="event.stopPropagation();this.closest(\'.mui-multiselect\').classList.toggle(\'open\')">';
                html += '<span class="mui-multiselect-label">All</span>';
                html += '<i class="fas fa-chevron-down mui-chevron"></i>';
                html += '</button>';
                html += '<div class="mui-multiselect-dropdown">';
                html += '<label><input type="checkbox" class="mui-ms-option" value="" checked data-key="' + config.key + '"> <span>All</span></label>';
                vals.forEach(function(v) {
                    html += '<label><input type="checkbox" class="mui-ms-option" value="' + escHtml(v) + '" data-key="' + config.key + '"> <span>' + escHtml(v) + '</span></label>';
                });
                html += '</div></div>';
                container.innerHTML = html;

                container.querySelectorAll('.mui-ms-option').forEach(function(cb) {
                    cb.addEventListener('change', function() {
                        var key = this.dataset.key;
                        var ms = this.closest('.mui-multiselect');
                        var allCb = ms.querySelector('input[data-key="' + key + '"][value=""]');
                        if (this.value === '') {
                            var checked = this.checked;
                            ms.querySelectorAll('input[data-key="' + key + '"]').forEach(function(c) { c.checked = checked; });
                        } else {
                            var allChecked = true;
                            ms.querySelectorAll('input[data-key="' + key + '"]:not([value=""])').forEach(function(c) {
                                if (!c.checked) allChecked = false;
                            });
                            allCb.checked = allChecked;
                        }
                        updateLabel(ms, key);
                        applyFilters();
                    });
                });

                container.querySelector('.mui-multiselect-dropdown').addEventListener('click', function(e) {
                    e.stopPropagation();
                });

                document.addEventListener('click', function(e) {
                    if (!container.contains(e.target)) {
                        container.querySelector('.mui-multiselect').classList.remove('open');
                    }
                });
            }

            function updateLabel(ms, key) {
                var checked = [];
                ms.querySelectorAll('input[data-key="' + key + '"]:not([value=""])').forEach(function(c) {
                    if (c.checked) checked.push(c.value);
                });
                var label = ms.querySelector('.mui-multiselect-label');
                if (checked.length === 0 || checked.length === ms.querySelectorAll('input[data-key="' + key + '"]:not([value=""])').length) {
                    label.textContent = 'All';
                } else {
                    label.textContent = checked.length + ' selected';
                }
            }

            function getSelected(key) {
                var ms = document.querySelector('.mui-multiselect[data-key="' + key + '"]');
                if (!ms) return [];
                var selected = [];
                ms.querySelectorAll('input[data-key="' + key + '"]:not([value=""])').forEach(function(c) {
                    if (c.checked) selected.push(c.value);
                });
                return selected;
            }

            function applyFilters() {
                var filters = {};
                filterConfig.forEach(function(fc) {
                    filters[fc.idx] = getSelected(fc.key);
                });
                filteredData = allData.filter(function(row) {
                    for (var colIdx in filters) {
                        var vals = filters[colIdx];
                        if (vals.length > 0 && vals.indexOf(row[colIdx]) === -1) return false;
                    }
                    return true;
                });
                renderGrid();
            }

            function clearFilters() {
                document.querySelectorAll('.mui-ms-option').forEach(function(cb) { cb.checked = cb.value === ''; });
                filterConfig.forEach(function(fc) {
                    var ms = document.querySelector('.mui-multiselect[data-key="' + fc.key + '"]');
                    if (ms) updateLabel(ms, fc.key);
                });
                applyFilters();
            }

            function selectAll(checked) {
                document.querySelectorAll('.deleted-chk').forEach(function(cb) { cb.checked = checked; });
            }

            function doRecover() {
                var checked = document.querySelectorAll('.deleted-chk:checked');
                if (checked.length === 0) {
                    alert('Please select one or more messages.');
                    return;
                }
                if (!confirm('Are you sure you wish to recover ' + checked.length + ' email(s)?')) return;
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/deleted';
                var inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'action';
                inp.value = 'Recover';
                form.appendChild(inp);
                checked.forEach(function(cb) {
                    var h = document.createElement('input');
                    h.type = 'hidden';
                    h.name = cb.value;
                    h.value = 'on';
                    form.appendChild(h);
                });
                document.body.appendChild(form);
                form.submit();
            }

            function closePreviewModal() {
                document.getElementById('emailPreviewModal').style.display = 'none';
                document.getElementById('emailPreviewFrame').src = '';
            }

            document.addEventListener('click', function(e) {
                var link = e.target.closest('.preview-link');
                if (!link) return;
                e.preventDefault();
                var key = link.dataset.mailkey;
                var view = link.dataset.view;
                if (!key) return;
                var showImages = document.getElementById('chkShowImages').checked;
                var url = view === 'html' ? 'emailPreview?isDeleted=true&view=HTML&mailKey=' + encodeURIComponent(key) : 'emailPreview?isDeleted=true&mailKey=' + encodeURIComponent(key);
                if (view === 'html' && showImages) url += '&showImages=true';
                document.getElementById('emailPreviewFrame').src = url;
                document.getElementById('emailPreviewModal').style.display = 'block';
            });

            document.getElementById('chkShowImages').addEventListener('change', function() {
                var frame = document.getElementById('emailPreviewFrame');
                var currentUrl = frame.src;
                if (!currentUrl || currentUrl === 'about:blank') return;
                var hasImages = currentUrl.indexOf('showImages=true') !== -1;
                if (this.checked && !hasImages) {
                    frame.src = currentUrl + '&showImages=true';
                } else if (!this.checked && hasImages) {
                    frame.src = currentUrl.replace(/[&?]showImages=true/, '');
                }
            });

            document.getElementById('chkSelectAll').addEventListener('change', function() {
                selectAll(this.checked);
            });

            document.getElementById('btn-recover').addEventListener('click', doRecover);
            document.getElementById('previewCloseBtn').addEventListener('click', closePreviewModal);

            // Double-click to show email details
            document.getElementById('deleted-grid').addEventListener('dblclick', function(e) {
                var row = e.target.closest('tr');
                if (!row) return;
                var checkbox = row.querySelector('.deleted-chk');
                if (!checkbox) return;
                var filepath = checkbox.value;
                var data = emailStore[filepath];
                if (!data) return;
                document.getElementById('infoModalFilepath').textContent = filepath;
                document.getElementById('infoModalSender').textContent = data.sender || 'N/A';
                document.getElementById('infoModalRecipients').textContent = data.recipients || 'N/A';
                document.getElementById('infoModalSubject').textContent = data.subject || 'N/A';
                document.getElementById('infoModalScore').textContent = data.spamScore !== undefined ? data.spamScore : 'N/A';
                document.getElementById('infoModalDetail').textContent = data.antiSpam || 'N/A';
                document.getElementById('infoModalDate').textContent = data.time || 'N/A';
                document.getElementById('infoModalReason').innerHTML = '<strong>Spam Reason:</strong> <em>Loading...</em>';
                document.getElementById('infoModal').style.display = 'block';
                fetch('/api/spam-reason/deleted/' + encodeURIComponent(filepath))
                    .then(function(r) { return r.json(); })
                    .then(function(result) {
                        var reason = result.reason || 'Not available';
                        document.getElementById('infoModalReason').innerHTML = '<strong>Spam Reason:</strong> ' + reason.replace(/</g, '&lt;');
                    })
                    .catch(function() {
                        document.getElementById('infoModalReason').innerHTML = '<strong>Spam Reason:</strong> <em>Not available</em>';
                    });
            });

            document.getElementById('infoModalCloseBtn').addEventListener('click', function() {
                document.getElementById('infoModal').style.display = 'none';
            });

            function renderGrid() {
                var container = document.getElementById('deleted-grid');
                if (grid) {
                    grid.updateConfig({ data: filteredData }).forceRender();
                } else {
                    grid = new gridjs.Grid({
                        columns: [
                            {
                                name: '',
                                width: '40px',
                                sort: false,
                                formatter: function(cell) {
                                    return gridjs.html('<input type="checkbox" class="deleted-chk" value="' + escHtml(cell) + '">');
                                }
                            },
                            { name: 'Time', width: '160px', sort: true },
                            { name: 'Sender', width: '220px', sort: true },
                            { name: 'Recipient', width: '120px', sort: true },
                            { name: 'Subject', width: '300px', sort: true },
                            { name: 'Score', width: '65px', sort: true },
                            { name: 'Reason', width: '200px', sort: true },
                            {
                                name: 'Actions',
                                width: '90px',
                                sort: false,
                                formatter: function(cell, row) {
                                    var filepath = row.cells[0].data;
                                    var safe = cell === true || cell === 'true';
                                    var html = '<button class="preview-btn preview-link" data-mailkey="' + escHtml(filepath) + '" data-view="text" title="Plain Text Preview"><i class="material-icons">article</i></button>';
                                    if (safe) {
                                        html += '&nbsp;<button class="preview-btn preview-link" data-mailkey="' + escHtml(filepath) + '" data-view="html" title="HTML Preview"><i class="material-icons">visibility</i></button>';
                                    }
                                    return gridjs.html(html);
                                }
                            }
                        ],
                        data: filteredData,
                        pagination: { limit: 10, summary: true },
                        search: { enabled: false },
                        sort: true,
                        language: {
                            'nothing found': '<div class="mui-empty"><i class="fas fa-trash-can"></i>No deleted messages found.</div>'
                        },
                        className: {
                            table: 'gridjs-table',
                            thead: 'gridjs-thead',
                            th: 'gridjs-th',
                            tbody: 'gridjs-tbody',
                            td: 'gridjs-td'
                        }
                    }).render(container);
                }
            }

            function doCustomSearch() {
                var q = customSearchInput.value.toLowerCase();
                if (!q) {
                    filteredData = allData.slice();
                    filterConfig.forEach(function(fc) {
                        var sel = getSelected(fc.key);
                        if (sel.length > 0 && sel.length < getDistinct(fc.idx).length) {
                            filteredData = filteredData.filter(function(row) { return sel.indexOf(row[fc.idx]) !== -1; });
                        }
                    });
                } else {
                    filteredData = allData.filter(function(row) {
                        for (var ci = 1; ci < row.length; ci++) {
                            if (String(row[ci]).toLowerCase().indexOf(q) !== -1) return true;
                        }
                        return false;
                    });
                    filterConfig.forEach(function(fc) {
                        var sel = getSelected(fc.key);
                        if (sel.length > 0 && sel.length < getDistinct(fc.idx).length) {
                            filteredData = filteredData.filter(function(row) { return sel.indexOf(row[fc.idx]) !== -1; });
                        }
                    });
                }
                renderGrid();
            }

            customSearchInput.addEventListener('input', doCustomSearch);

            document.getElementById('btn-csv').addEventListener('click', function() {
                var rows = grid ? grid.config.data : filteredData;
                var header = ['File','Time','Sender','Recipient','Subject','Score','Reason'];
                var csv = header.join(',') + '\\n';
                rows.forEach(function(r) {
                    var vals = [r[0], r[1], r[2], r[3], r[4], r[5], r[6]];
                    var esc = vals.map(function(c) { return '"' + String(c).replace(/"/g, '""') + '"'; });
                    csv += esc.join(',') + '\\n';
                });
                var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                var link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'DeletedMessages.csv';
                link.click();
                URL.revokeObjectURL(link.href);
            });

            document.getElementById('btn-copy').addEventListener('click', function() {
                var rows = grid ? grid.config.data : filteredData;
                var header = ['Time','Sender','Recipient','Subject','Score','Reason'];
                var pad = [20, 30, 30, 40, 8, 20];
                function fmtRow(arr) {
                    var vals = [arr[1], arr[2], arr[3], arr[4], arr[5], arr[6]];
                    return vals.map(function(c, i) { return String(c).padEnd(pad[i] || 20).slice(0, pad[i] || 20); }).join(' | ');
                }
                var text = fmtRow(header) + '\\n' + '-'.repeat(fmtRow(header).length) + '\\n';
                text += rows.map(fmtRow).join('\\n');
                navigator.clipboard.writeText(text).then(function() {
                    var btn = document.getElementById('btn-copy');
                    var orig = btn.innerHTML;
                    btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                    setTimeout(function() { btn.innerHTML = orig; }, 2000);
                });
            });

            document.getElementById('btn-print').addEventListener('click', function() {
                var rows = grid ? grid.config.data : filteredData;
                var win = window.open('', '_blank');
                var html = '<!DOCTYPE html><html><head><title>Deleted Messages</title>';
                html += '<style>body{font-family:Roboto,sans-serif;margin:20px;}';
                html += 'h2{color:#1e293b;}table{border-collapse:collapse;width:100%;font-size:12px;}';
                html += 'th{background:#1976d2;color:#fff;padding:8px 10px;text-align:left;font-size:11px;text-transform:uppercase;}';
                html += 'td{padding:6px 10px;border-bottom:1px solid #e2e8f0;}tr:nth-child(even){background:#fafafa;}</style></head><body>';
                html += '<h2>Deleted Messages</h2><table><thead><tr>';
                html += '<th>Time</th><th>Sender</th><th>Recipient</th><th>Subject</th><th>Score</th><th>Reason</th>';
                html += '</tr></thead><tbody>';
                rows.forEach(function(r) {
                    html += '<tr><td>' + escHtml(r[1]) + '</td><td>' + escHtml(r[2]) + '</td><td>' + escHtml(r[3]) + '</td><td>' + escHtml(r[4]) + '</td><td>' + escHtml(r[5]) + '</td><td>' + escHtml(r[6]) + '</td></tr>';
                });
                html += '</tbody></table></body></html>';
                win.document.write(html);
                win.document.close();
                win.focus();
                win.print();
            });

            document.getElementById('btn-clear-filters').addEventListener('click', clearFilters);

            filterConfig.forEach(function(fc) {
                buildMultiSelect('ms-' + fc.key, fc);
            });

            // Date filter navigation
            document.getElementById('btn-date-go').addEventListener('click', function() {
                var df = document.getElementById('dateFrom').value;
                var dt = document.getElementById('dateTo').value;
                var params = new URLSearchParams(window.location.search);
                params.delete('today');
                if (df) params.set('dateFrom', df); else params.delete('dateFrom');
                if (dt) params.set('dateTo', dt); else params.delete('dateTo');
                window.location.search = params.toString();
            });

            renderGrid();
        });

    .deleted-grid-wrapper
        .mui-card
            .mui-last-update Last updated: <span id="last-update"></span>
            .mui-filters-row
                .mui-filters-left
                    .mui-btn#btn-csv
                        i.fas.fa-file-csv
                        | CSV
                    .mui-btn#btn-copy
                        i.fas.fa-copy
                        | Copy
                    .mui-btn#btn-print
                        i.fas.fa-print
                        | Print
                    .mui-btn-separator
                    .mui-btn.mui-btn-recover#btn-recover
                        i.fas.fa-undo-alt
                        | Recover
                    .mui-btn-separator
                    .mui-select-all
                        input#chkSelectAll(type="checkbox")
                        label(for="chkSelectAll") Select All
                    .mui-btn-separator
                    .mui-filter-group
                        label Recipient
                        #ms-recipient
                    button.mui-filter-clear#btn-clear-filters Clear
                .mui-filters-right
                    .mui-date-filter
                        label From
                        input.mui-date-input#dateFrom(type="date" value=dateFrom || '')
                        label To
                        input.mui-date-input#dateTo(type="date" value=dateTo || '')
                        button.mui-btn#btn-date-go(type="button") Go
                    input#custom-search(type="search" placeholder="Search..." style="margin-left:8px;")
            if today
                .mui-filter-banner
                    i.fas.fa-calendar-day
                    |  Showing today's data only
                    .mui-filter-banner-clear
                        a(href=todayViewAllUrl)
                            i.fas.fa-times
                            |  View all
            .mui-divider
            #deleted-grid

    #emailPreviewModal.preview-modal
        .preview-modal-content
            div(style="display:flex; justify-content:space-between; align-items:center;")
                h2 Email Preview
                div(style="display:flex; align-items:center; gap:12px;")
                    label(for="chkShowImages" style="font-size:0.85rem; white-space:nowrap; cursor:pointer;")
                        input#chkShowImages(type="checkbox" style="margin-right:4px;")
                        | Show Images
                    button#previewCloseBtn.mui-btn(type="button") Close
            iframe#emailPreviewFrame

    #infoModal.preview-modal
        .info-modal-content
            div(style="display:flex; justify-content:space-between; align-items:center;")
                h2 Email Details
                button#infoModalCloseBtn.mui-btn(type="button") Close
            div#infoModalBody
                .info-field
                    .info-field-label File
                    .info-field-value#infoModalFilepath
                .info-field
                    .info-field-label Sender
                    .info-field-value#infoModalSender
                .info-field
                    .info-field-label Recipients
                    .info-field-value#infoModalRecipients
                .info-field
                    .info-field-label Subject
                    .info-field-value#infoModalSubject
                .info-field
                    .info-field-label Score
                    .info-field-value#infoModalScore
                .info-field
                    .info-field-label Spam Detail
                    .info-field-value#infoModalDetail
                .info-field
                    .info-field-label Date/Time
                    .info-field-value#infoModalDate
                .info-field
                    .info-field-label Reason
                    .info-field-value#infoModalReason
