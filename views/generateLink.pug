extends adminLayout

block css
  style.
    .link-container {
      max-width: 800px;
      margin-top: 20px;
    }
    .link-container label {
      font-weight: 600;
      display: block;
      margin-bottom: 6px;
    }
    .link-container input[type="email"] {
      width: 100%;
      padding: 10px 12px;
      font-size: 14px;
      border: 1px solid #ccc;
      border-radius: 4px;
      box-sizing: border-box;
    }
    .link-container input[type="email"]:focus {
      border-color: #4a90d9;
      outline: none;
      box-shadow: 0 0 4px rgba(74,144,217,0.3);
    }
    .link-container button {
      margin-top: 12px;
      padding: 10px 24px;
      font-size: 14px;
      background: #4a90d9;
      color: #fff;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    .link-container button:hover {
      background: #357abd;
    }
    .generated-link {
      margin-top: 20px;
      padding: 14px 16px;
      background: #e8f5e9;
      border: 1px solid #a5d6a7;
      border-radius: 4px;
      word-break: break-all;
    }
    .generated-link a {
      color: #2e7d32;
      font-weight: 600;
      text-decoration: none;
    }
    .generated-link a:hover {
      text-decoration: underline;
    }
    .error-msg {
      margin-top: 12px;
      padding: 10px 14px;
      background: #fce4ec;
      border: 1px solid #ef9a9a;
      border-radius: 4px;
      color: #c62828;
    }
  link(id="favicon" rel="icon" href="/img/MailPickupAgent.png" type="image/png")
  
block content
  .container
    .header-bar
      h1 Generate Mail Queue Access Link
    .link-container
      form(method="POST" action="/generateLink")
        label(for="email") Email Address
        input#email(type="email" name="email" placeholder="user@example.com" value=email || '' required)
        br
        button(type="submit") Generate Link

      if error
        .error-msg #{error}

      if link
        .generated-link
          p
            strong Access Link:
          a(href=link target="_blank") #{link}
          p(style="margin-top:8px;font-size:13px;color:#555;")
            | This link will grant access to the Mail Queue filtered for this email address.
