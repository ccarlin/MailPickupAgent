extends adminLayout

block css
  style.
    .link-container {
      max-width: 800px;
      margin-top: 20px;
    }
    .link-container label {
      font-weight: 600;
      display: block;
      margin-bottom: 6px;
    }
    .link-container input[type="email"] {
      width: 100%;
      padding: 10px 12px;
      font-size: 14px;
      border: 1px solid #ccc;
      border-radius: 4px;
      box-sizing: border-box;
    }
    .link-container input[type="email"]:focus {
      border-color: #4a90d9;
      outline: none;
      box-shadow: 0 0 4px rgba(74,144,217,0.3);
    }
    .link-container button {
      margin-top: 12px;
      padding: 10px 24px;
      font-size: 14px;
      background: #4a90d9;
      color: #fff;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    .link-container button:hover {
      background: #357abd;
    }
    .generated-link {
      margin-top: 20px;
      padding: 14px 16px;
      background: #e8f5e9;
      border: 1px solid #a5d6a7;
      border-radius: 4px;
    }
    .generated-link .link-row {
      display: flex;
      gap: 8px;
      align-items: stretch;
      margin-top: 8px;
    }
    .generated-link .link-row input {
      flex: 1;
      padding: 10px 12px;
      font-size: 14px;
      font-family: monospace;
      border: 1px solid #a5d6a7;
      border-radius: 4px;
      background: #fff;
      color: #2e7d32;
      outline: none;
      cursor: text;
    }
    .generated-link .link-row button {
      padding: 10px 16px;
      font-size: 14px;
      font-weight: 600;
      background: #2e7d32;
      color: #fff;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      white-space: nowrap;
    }
    .generated-link .link-row button:hover {
      background: #1b5e20;
    }
    .generated-link .link-row button.copied {
      background: #558b2f;
    }
    .error-msg {
      margin-top: 12px;
      padding: 10px 14px;
      background: #fce4ec;
      border: 1px solid #ef9a9a;
      border-radius: 4px;
      color: #c62828;
    }
  link(id="favicon" rel="icon" href="/img/MailPickupAgent.png" type="image/png")
  
block content
  .container
    .header-bar
      h1 Generate Mail Queue Access Link
    .link-container
      form(method="POST" action="/generateLink")
        label(for="email") Email Address
        input#email(type="email" name="email" placeholder="user@example.com" value=email || '' required)
        br
        button(type="submit") Generate Link

      if error
        .error-msg #{error}

      if link
        .generated-link
          p(style="margin:0;")
            strong Access Link
            span(style="font-weight:400;font-size:13px;color:#555;margin-left:8px;")
              | (share this with the user)
          .link-row
            input(type="text" readonly value=link onclick="this.select()" id="shareLink")
            button(onclick="copyLink()" id="copyBtn") Copy
          p(style="margin:8px 0 0;font-size:13px;color:#555;")
            | This link will grant access to the Mail Queue filtered for this email address.

        script.
          function copyLink() {
            const input = document.getElementById('shareLink');
            const btn = document.getElementById('copyBtn');
            input.select();
            input.setSelectionRange(0, 99999);
            try {
              navigator.clipboard.writeText(input.value);
              btn.textContent = 'Copied!';
              btn.classList.add('copied');
              setTimeout(() => {
                btn.textContent = 'Copy';
                btn.classList.remove('copied');
              }, 2500);
            } catch {
              document.execCommand('copy');
              btn.textContent = 'Copied!';
              setTimeout(() => btn.textContent = 'Copy', 2500);
            }
          }
