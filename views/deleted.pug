block content
    script.
        $(document).ready(function () {
            var timeout = setTimeout("location.reload(true);", 600000);
            $('#chkSelectAll').click(function () {
                $('input:checkbox').not(this).prop('checked', this.checked);
            });
            var table = $('#GridView1').DataTable({
                order: [[ 1, "desc" ]],
                pageLength: 10, 
                layout: {
                    topStart: { buttons: ['pageLength', 'copy', 'csv', 'excel', 'pdf', 'print',
                        {
                            text: 'Recover',
                            className: 'myMiniButton',
                            action: function(e, dt, node, config) {
                                if (ConfirmFunction('recover')) {
                                    $('<input>').attr({ type: 'hidden', name: 'action', value: 'Recover' }).appendTo('form');
                                    $('form').submit();
                                }
                            }
                        }
                    ]},
                    topEnd: 'search',
                    bottomStart: 'info',
                    bottomEnd: 'paging'                
                },
                language: {"emptyTable": "No deleted messages found.", "zeroRecords": "No matches found."},         
                initComplete: function () {    
                    var btns = $('.dt-button');
                    btns.addClass('myMiniButton');
                    btns.removeClass('dt-button');               
                    [3].forEach(idx => multiFilterSetup(this.api().column(idx), 100));                             
                }
            });
        });

        function ConfirmFunction(action) {
            var selectCount = $("table[id*=GridView1] input[type=checkbox][id*=chkItem]:checked").length;
            if (selectCount > 0) {
                var msg = "Are you sure you wish to " + action + " " + selectCount + " email(s)?";
                return confirm(msg);
            } else {
                alert("Please select one or more messages.");
                return false;
            }
        };

        function closePreviewModal() {
            $('#emailPreviewModal').hide();
            $('#emailPreviewFrame').attr('src', '');
        }

        $(document).on('click', '.preview-link', function (e) {
            e.preventDefault();
            var key = $(this).data('mailkey');
            var view = $(this).data('view');
            if (!key) return;
            var url = view === 'html' ? 'emailPreview?isDeleted=true&view=HTML&mailKey=' + encodeURIComponent(key) : 'emailPreview?isDeleted=true&mailKey=' + encodeURIComponent(key);
            $('#emailPreviewFrame').attr('src', url);
            $('#emailPreviewModal').show();
        });

    div(align="right" style="margin-bottom:4px;") #{currentTime}
    form(action='/deleted', method="POST")
        div
            table#GridView1(class="row-border compact order-column hover stripe" style='width: 100%; font-size: small')
                thead
                    th(scope='col')
                        input#chkSelectAll(type='checkbox')
                    th(align='left' scope='col' style='white-space: nowrap;') Time
                    th(scope='col') Sender
                    th(scope='col') Recipient
                    th(scope='col') Subject
                    th(align='left' scope='col' style='white-space: nowrap;') Score
                    th(scope='col') Reason
                    th(align='left' scope='col' style='white-space: nowrap;') Actions
                each email, idx in emails
                    tr
                        td
                            - var uniqueId = 'GridView1_chkItem_' + idx;
                            input(type='checkbox' id=uniqueId name=email.filepath)
                        td #{formatTime(email.timeAcquired)}
                        td #{email.sender}
                        td #{email.recipients}
                        td #{email.subject}
                        td #{isNaN(Number(email.spamScore)) ? email.spamScore : +Number(email.spamScore).toFixed(1)}
                        td #{email.antiSpam}
                        td(style="white-space: nowrap;")
                            button.btn.btn-preview.preview-link(type="button" data-mailkey=email.filepath data-view="text" title="Plain Text Preview")
                                i.material-icons article
                            if (email.safe)
                                |&nbsp;
                                button.btn.btn-preview.preview-link(type="button" data-mailkey=email.filepath data-view="html" title="HTML Preview")
                                    i.material-icons visibility
                tfoot 
                    tr 
                        td 
                        td 
                        td 
                        td 
                        td 
                        td 
                        td 
                        td 


    #emailPreviewModal.preview-modal
        .preview-modal-content
            div(style="display:flex; justify-content:space-between; align-items:center;")
                h2 Email Preview
                button.myButton(onclick="closePreviewModal()") Close
            iframe#emailPreviewFrame                       
