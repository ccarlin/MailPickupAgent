    style.       
        #GridView1 td, #GridView1 th { white-space: normal; word-break: break-word; }
        .btn-preview { background-color: #6c757d; color: white; padding: 4px 6px; border-radius: 4px; border: none; cursor: pointer; font-size: 0.8rem; }
        .btn-preview .material-icons { font-size: 14px; vertical-align: middle; }
        .preview-modal {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0,0,0,0.7); z-index: 100;
            display: none;
        }
        .preview-modal-content {
            position: absolute; top: 50%; left: 50%;
            transform: translate(-50%,-50%);
            background: white; padding: 20px; border-radius: 10px;
            width: 85vw; height: 85vh;
            display: flex; flex-direction: column;
        }
        .preview-modal-content h2 {
            margin: 0 0 10px 0;
        }
        .preview-modal-content iframe {
            flex: 1; border: 1px solid #ddd; border-radius: 4px;
        }
    link(id="favicon" rel="icon" href="/img/MailPickupAgent.png" type="image/png")
    
