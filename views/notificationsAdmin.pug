extends adminLayout

block css
    link(href="https://cdn.jsdelivr.net/npm/gridjs/dist/theme/mermaid.min.css" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet")
    link(id="favicon" rel="icon" href="/img/MailPickupAgent.png" type="image/png" sizes="16x16")
    style.
        .endpoint-cell {
            font-size: 12px;
            color: #64748b;
            max-width: 300px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            display: inline-block;
            vertical-align: middle;
        }
        .badge-filter {
            display: inline-block;
            padding: 2px 8px;
            font-size: 11px;
            font-weight: 600;
            background: #dbeafe;
            color: #1d4ed8;
            border-radius: 10px;
        }
        .badge-all {
            display: inline-block;
            padding: 2px 8px;
            font-size: 11px;
            font-weight: 600;
            background: #dcfce7;
            color: #16a34a;
            border-radius: 10px;
        }

        @media (max-width: 768px) {
            .endpoint-cell {
                max-width: 120px;
                font-size: 11px;
            }
        }
        @media (max-width: 480px) {
            .endpoint-cell {
                max-width: 80px;
                font-size: 10px;
            }
            .mui-filters-row {
                padding: 6px 10px;
                flex-direction: column;
                align-items: stretch;
            }
            .mui-filters-row .mui-filters-right input {
                width: 100%;
                box-sizing: border-box;
            }
        }

block scripts
    script(src="https://cdn.jsdelivr.net/npm/gridjs/dist/gridjs.umd.js")

block content
    script.
        document.addEventListener('DOMContentLoaded', function() {
            var subscriptions = !{JSON.stringify(subscriptions)};
            var allData = subscriptions.map(function(s) {
                var sub = JSON.parse(s.subscription);
                var endpoint = sub.endpoint || 'unknown';
                var filterDisplay = s.email_filter ? '<span class="badge-filter">' + String(s.email_filter).replace(/</g, '&lt;') + '</span>' : '<span class="badge-all">All</span>';
                var ip = s.ip_address || '—';
                return [s.id, endpoint, filterDisplay, ip, s.created_at];
            });

            var grid = null;
            var filteredData = allData.slice();
            var customSearchInput = document.getElementById('custom-search');

            function renderGrid() {
                var container = document.getElementById('notif-grid');
                if (grid) {
                    grid.updateConfig({ data: filteredData }).forceRender();
                } else {
                    grid = new gridjs.Grid({
                        columns: [
                            { name: 'ID', hidden: true },
                            {
                                name: 'Endpoint',
                                width: 'auto',
                                sort: true,
                                formatter: function(cell) {
                                    return gridjs.html('<span class="endpoint-cell" title="' + String(cell).replace(/"/g, '&quot;') + '">' + String(cell).replace(/</g, '&lt;') + '</span>');
                                }
                            },
                            {
                                name: 'Email Filter',
                                width: '140px',
                                sort: true,
                                formatter: function(cell) {
                                    return gridjs.html(cell);
                                }
                            },
                            {
                                name: 'IP Address',
                                width: '150px',
                                sort: true
                            },
                            {
                                name: 'Created',
                                width: '180px',
                                sort: true
                            },
                            {
                                name: 'Actions',
                                width: '120px',
                                sort: false,
                                formatter: function(cell, row) {
                                    var id = row.cells[0].data;
                                    var html = '<form method="POST" action="/notificationsAdmin/' + encodeURIComponent(id) + '/delete" onsubmit="return confirm(\'Remove this notification subscription? The browser will no longer receive push notifications.\')" style="margin:0;">';
                                    html += '<button type="submit" class="action-btn">Remove</button>';
                                    html += '</form>';
                                    return gridjs.html(html);
                                }
                            }
                        ],
                        data: filteredData,
                        pagination: { limit: 15, summary: true },
                        search: { enabled: false },
                        sort: true,
                        language: {
                            'nothing found': '<div class="mui-empty"><i class="fas fa-bell-slash"></i>No notification subscriptions found.</div>'
                        },
                        className: {
                            table: 'gridjs-table',
                            thead: 'gridjs-thead',
                            th: 'gridjs-th',
                            tbody: 'gridjs-tbody',
                            td: 'gridjs-td'
                        }
                    }).render(container);
                }
            }

            function doCustomSearch() {
                var q = customSearchInput.value.toLowerCase();
                if (!q) {
                    filteredData = allData.slice();
                } else {
                    filteredData = allData.filter(function(row) {
                        for (var ci = 1; ci < 5; ci++) {
                            if (String(row[ci]).toLowerCase().indexOf(q) !== -1) return true;
                        }
                        return false;
                    });
                }
                renderGrid();
            }

            customSearchInput.addEventListener('input', doCustomSearch);

            document.getElementById('notif-count').textContent = allData.length;

            renderGrid();
        });

    .notif-grid-wrapper
        .mui-card
            .mui-filters-row
                .mui-filters-left
                    span(style="font-size:0.8125rem;color:#64748b;") 
                        span#notif-count 0
                        |  subscription(s)
                .mui-filters-right
                    input#custom-search(type="search" placeholder="Search subscriptions...")
            .mui-divider
            #notif-grid
