block css
    link(href="https://cdn.jsdelivr.net/npm/gridjs/dist/theme/mermaid.min.css" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet")
    style.
        .quarantine-grid-wrapper {
            font-family: 'Roboto', sans-serif;
            margin: 0.5rem 0;
        }
        .quarantine-grid-wrapper .gridjs-container {
            font-family: 'Roboto', sans-serif;
            color: #1e293b;
        }
        .quarantine-grid-wrapper .gridjs-head {
            display: none;
        }
        .quarantine-grid-wrapper table {
            border-collapse: collapse;
            width: 100%;
            font-size: 0.8125rem;
        }
        .quarantine-grid-wrapper td {
            overflow: visible !important;
            text-overflow: clip !important;
        }
        .quarantine-grid-wrapper th {
            background: #1976d2;
            color: #fff;
            font-weight: 500;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 2px 8px;
            text-align: left;
            white-space: nowrap;
            border: none;
            user-select: none;
            vertical-align: middle;
            line-height: 1.6;
        }
        .quarantine-grid-wrapper th:hover {
            background: #1565c0;
        }
        .quarantine-grid-wrapper th .gridjs-th-content {
            float: left;
            white-space: nowrap;
            overflow: visible !important;
            text-overflow: clip !important;
            width: calc(100% - 16px);
        }
        .quarantine-grid-wrapper th .gridjs-sort {
            filter: brightness(0) invert(1);
            opacity: 0.7;
        }
        .quarantine-grid-wrapper th .gridjs-sort:hover {
            opacity: 1;
        }
        .quarantine-grid-wrapper td {
            padding: 10px 16px;
            border-bottom: 1px solid #e2e8f0;
            color: #334155;
            word-break: break-word;
        }
        .quarantine-grid-wrapper tbody tr {
            transition: background-color 0.15s ease;
        }
        .quarantine-grid-wrapper tbody tr:hover {
            background-color: #e3f2fd;
        }
        .quarantine-grid-wrapper tbody tr:nth-child(even) {
            background-color: #fafafa;
        }
        .quarantine-grid-wrapper tbody tr:nth-child(even):hover {
            background-color: #e3f2fd;
        }
        .quarantine-grid-wrapper .gridjs-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 16px;
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
            font-size: 0.8125rem;
            color: #64748b;
        }
        .quarantine-grid-wrapper .gridjs-pagination {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .quarantine-grid-wrapper .gridjs-pagination button {
            min-width: 32px;
            height: 32px;
            padding: 0 8px;
            border: 1px solid #e2e8f0;
            border-radius: 4px;
            background: #fff;
            color: #334155;
            font-family: 'Roboto', sans-serif;
            font-size: 0.8125rem;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .quarantine-grid-wrapper .gridjs-pagination button:hover:not(:disabled) {
            background: #e3f2fd;
            border-color: #1976d2;
            color: #1976d2;
        }
        .quarantine-grid-wrapper .gridjs-pagination button:disabled {
            opacity: 0.4;
            cursor: default;
        }
        .quarantine-grid-wrapper .gridjs-pagination button.gridjs-currentPage {
            background: #1976d2;
            color: #fff;
            border-color: #1976d2;
            font-weight: 500;
        }
        .quarantine-grid-wrapper .gridjs-summary {
            color: #64748b;
            font-size: 0.8125rem;
        }
        .quarantine-grid-wrapper .gridjs-table-wrap {
            overflow-x: auto;
        }
