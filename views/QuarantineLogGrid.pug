        .mui-filters-row .mui-filters-right input:focus {
            border-color: #1976d2;
            box-shadow: 0 0 0 2px rgba(25,118,210,0.15);
        }
        .mui-multiselect {
            position: relative;
            display: inline-block;
        }
        .mui-multiselect-toggle {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 10px;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            font-family: 'Roboto', sans-serif;
            font-size: 0.8125rem;
            color: #334155;
            background: #fff;
            cursor: pointer;
            outline: none;
            transition: border-color 0.2s;
            min-width: 130px;
            max-width: 200px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .mui-multiselect-toggle:focus {
            border-color: #1976d2;
            box-shadow: 0 0 0 2px rgba(25,118,210,0.15);
        }
        .mui-multiselect-toggle .mui-chevron {
            font-size: 0.65rem;
            color: #94a3b8;
            margin-left: auto;
            transition: transform 0.2s;
        }
        .mui-multiselect.open .mui-chevron {
            transform: rotate(180deg);
        }
        .mui-multiselect-dropdown {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            z-index: 1000;
            min-width: 200px;
            max-height: 260px;
            overflow-y: auto;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
            padding: 4px 0;
            margin-top: 2px;
        }
        .mui-multiselect.open .mui-multiselect-dropdown {
            display: block;
        }
        .mui-multiselect-dropdown label {
            display: flex;
            align-items: center;
            gap: 6px;
