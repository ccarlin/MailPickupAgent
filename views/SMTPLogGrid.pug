        }
        .mui-empty i {
            font-size: 2.5rem;
            display: block;
            margin-bottom: 12px;
            color: #cbd5e1;
        }
        .mui-btn {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 5px 12px;
            font-family: 'Roboto', sans-serif;
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            background: #fff;
            color: #475569;
            cursor: pointer;
            transition: all 0.15s ease;
