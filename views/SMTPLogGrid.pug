    link(href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet")
    style.
        .smtp-grid-wrapper {
            font-family: 'Roboto', sans-serif;
            margin: 0.5rem 0;
        }
        .smtp-grid-wrapper .gridjs-container {
            font-family: 'Roboto', sans-serif;
            color: #1e293b;
        }
        .smtp-grid-wrapper .gridjs-head {
            display: none;
        }
        .smtp-grid-wrapper table {
            border-collapse: collapse;
            width: 100%;
            font-size: 0.8125rem;
        }
        .smtp-grid-wrapper td {
            overflow: visible !important;
            text-overflow: clip !important;
        }
        .smtp-grid-wrapper th {
            background: #1976d2;
            color: #fff;
            font-weight: 500;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 6px 8px;
            text-align: left;
            white-space: nowrap;
            border: none;
            user-select: none;
            vertical-align: middle;
            line-height: 1.6;
        }
        .smtp-grid-wrapper th:hover {
            background: #1565c0;
        }
        .smtp-grid-wrapper th .gridjs-th-content {
            float: left;
            white-space: nowrap;
            overflow: visible !important;
            text-overflow: clip !important;
            width: calc(100% - 16px);
        }
        .smtp-grid-wrapper th .gridjs-sort {
            filter: brightness(0) invert(1);
            opacity: 0.7;
        }
        .smtp-grid-wrapper th .gridjs-sort:hover {
            opacity: 1;
        }
        .smtp-grid-wrapper td {
            padding: 10px 16px;
            border-bottom: 1px solid #e2e8f0;
            color: #334155;
            word-break: break-word;
        }
        .smtp-grid-wrapper tbody tr {
            transition: background-color 0.15s ease;
        }
        .smtp-grid-wrapper tbody tr:hover {
            background-color: #e3f2fd;
        }
        .smtp-grid-wrapper tbody tr:nth-child(even) {
            background-color: #fafafa;
        }
        .smtp-grid-wrapper tbody tr:nth-child(even):hover {
