block scripts
    script(src="https://cdn.jsdelivr.net/npm/gridjs/dist/gridjs.umd.js")

block content
    script.
        document.addEventListener('DOMContentLoaded', function() {
            var logData = !{JSON.stringify(logData)};
            var allData = logData.map(function(e) {
                var danger = (Number(e.Failures) > 100) || (Number(e.UserCount) > 50);
                var ipDisplay = e.ipAddress;
                if (Number(e.UniqueIPCount) > 1) {
                    ipDisplay = e.ipAddress + ' (' + e.UniqueIPCount + ')';
                }
                return [ipDisplay, e.Country, e.FirstSeen, e.LastSeen, e.DaysSeen, e.Attempts, e.Failures, e.FailedSend, e.Success, e.UserCount, e.UserDisplay, danger, e.ipLookup, e.BlockedIP];
            });

            var grid = null;
            var filteredData = allData.slice();
            var customSearchInput = document.getElementById('custom-search');

            function updateTotals() {
                var totalAttempts = 0, totalFailures = 0, totalFailedRelay = 0, totalSuccess = 0;
                filteredData.forEach(function(row) {
                    totalAttempts += Number(row[5]) || 0;
                    totalFailures += Number(row[6]) || 0;
                    totalFailedRelay += Number(row[7]) || 0;
                    totalSuccess += Number(row[8]) || 0;
                });
                document.getElementById('total-attempts').textContent = totalAttempts.toLocaleString('en-US');
                document.getElementById('total-failures').textContent = totalFailures.toLocaleString('en-US');
                document.getElementById('total-failedrelay').textContent = totalFailedRelay.toLocaleString('en-US');
                document.getElementById('total-success').textContent = totalSuccess.toLocaleString('en-US');
            }

            var filterConfig = [
                { idx: 1, label: 'Country', key: 'country' }
            ];

            function getDistinct(colIdx) {
                var set = {};
                allData.forEach(function(row) {
                    var v = (row[colIdx] || '').trim();
                    if (v) set[v] = true;
                });
                return Object.keys(set).sort(function(a, b) { return a.localeCompare(b); });
            }

            function buildMultiSelect(containerId, config) {
                var container = document.getElementById(containerId);
                var vals = getDistinct(config.idx);
                var html = '<div class="mui-multiselect" data-key="' + config.key + '">';
                html += '<button type="button" class="mui-multiselect-toggle" onclick="event.stopPropagation();this.closest(\'.mui-multiselect\').classList.toggle(\'open\')">';
                html += '<span class="mui-multiselect-label">All</span>';
                html += '<i class="fas fa-chevron-down mui-chevron"></i>';
                html += '</button>';
                html += '<div class="mui-multiselect-dropdown">';
                html += '<label><input type="checkbox" class="mui-ms-option" value="" checked data-key="' + config.key + '"> <span>All</span></label>';
                vals.forEach(function(v) {
                    html += '<label><input type="checkbox" class="mui-ms-option" value="' + v.replace(/"/g, '&quot;') + '" data-key="' + config.key + '"> <span>' + v + '</span></label>';
                });
                html += '</div></div>';
                container.innerHTML = html;

                container.querySelectorAll('.mui-ms-option').forEach(function(cb) {
                    cb.addEventListener('change', function() {
                        var key = this.dataset.key;
                        var ms = this.closest('.mui-multiselect');
                        var allCb = ms.querySelector('input[data-key="' + key + '"][value=""]');
                        if (this.value === '') {
                            var checked = this.checked;
                            ms.querySelectorAll('input[data-key="' + key + '"]').forEach(function(c) { c.checked = checked; });
                        } else {
                            var allChecked = true;
                            ms.querySelectorAll('input[data-key="' + key + '"]:not([value=""])').forEach(function(c) {
                                if (!c.checked) allChecked = false;
                            });
                            allCb.checked = allChecked;
                        }
                        updateLabel(ms, key);
                        applyFilters();
                    });
                });

                container.querySelector('.mui-multiselect-dropdown').addEventListener('click', function(e) {
                    e.stopPropagation();
                });

                document.addEventListener('click', function(e) {
                    if (!container.contains(e.target)) {
                        container.querySelector('.mui-multiselect').classList.remove('open');
                    }
                });
            }

            function updateLabel(ms, key) {
                var checked = [];
                ms.querySelectorAll('input[data-key="' + key + '"]:not([value=""])').forEach(function(c) {
                    if (c.checked) checked.push(c.value);
                });
                var label = ms.querySelector('.mui-multiselect-label');
                if (checked.length === 0 || checked.length === ms.querySelectorAll('input[data-key="' + key + '"]:not([value=""])').length) {
                    label.textContent = 'All';
                } else {
                    label.textContent = checked.length + ' selected';
                }
            }

            function getSelected(key) {
                var ms = document.querySelector('.mui-multiselect[data-key="' + key + '"]');
                if (!ms) return [];
                var selected = [];
                ms.querySelectorAll('input[data-key="' + key + '"]:not([value=""])').forEach(function(c) {
                    if (c.checked) selected.push(c.value);
                });
                return selected;
            }

            function applyFilters() {
                var filters = {};
                filterConfig.forEach(function(fc) {
                    filters[fc.idx] = getSelected(fc.key);
                });
                filteredData = allData.filter(function(row) {
                    for (var colIdx in filters) {
                        var vals = filters[colIdx];
                        if (vals.length > 0 && vals.indexOf(row[colIdx]) === -1) return false;
                    }
                    return true;
                });
                renderGrid();
            }

            function clearFilters() {
                document.querySelectorAll('.mui-ms-option').forEach(function(cb) { cb.checked = cb.value === ''; });
                filterConfig.forEach(function(fc) {
                    var ms = document.querySelector('.mui-multiselect[data-key="' + fc.key + '"]');
                    if (ms) updateLabel(ms, fc.key);
                });
                applyFilters();
            }

            function fmtCell(cell, row) {
                var isDanger = row.cells[11].data;
                if (isDanger) {
                    return gridjs.html('<span style="color:#dc2626;">' + String(cell).replace(/</g, '&lt;') + '</span>');
                }
                return String(cell);
            }

            function renderGrid() {
                var container = document.getElementById('smtp-grid');
                if (grid) {
                    grid.updateConfig({ data: filteredData }).forceRender();
                } else {
                    grid = new gridjs.Grid({
                        columns: [
                            {
                                name: 'IP Address',
                                width: '170px',
                                sort: true,
                                formatter: function(cell, row) {
                                    var lookup = row.cells[12].data;
                                    var isDanger = row.cells[11].data;
                                    var style = isDanger ? ' style="color:#dc2626;"' : '';
                                    return gridjs.html('<a href="' + lookup + '" target="_blank"' + style + '>' + cell + '</a>');
                                }
                            },
                            {
                                name: 'Country',
                                width: '100px',
                                sort: true,
                                formatter: function(cell, row) {
                                    var blocked = row.cells[13].data;
                                    var isDanger = row.cells[11].data;
                                    var cls = '';
                                    if (blocked) cls += 'blocked-ip ';
                                    if (isDanger) cls += 'danger-row ';
                                    if (cls) {
                                        return gridjs.html('<span class="' + cls.trim() + '">' + String(cell).replace(/</g, '&lt;') + '</span>');
                                    }
                                    return String(cell);
                                }
                            },
                            { name: 'First Seen', width: '110px', sort: true, formatter: fmtCell },
                            { name: 'Last Seen', width: '110px', sort: true, formatter: fmtCell },
                            { name: 'Days Seen', width: '90px', sort: true, formatter: fmtCell },
                            {
                                name: 'Attempts',
                                width: '90px',
                                sort: true,
                                formatter: function(cell, row) {
                                    var val = Number(cell).toLocaleString('en-US');
                                    var isDanger = row.cells[11].data;
                                    if (isDanger) {
                                        return gridjs.html('<span style="color:#dc2626;">' + val + '</span>');
                                    }
                                    return val;
                                }
                            },
                            {
                                name: 'Failures',
                                width: '90px',
                                sort: true,
                                formatter: function(cell, row) {
                                    var val = Number(cell).toLocaleString('en-US');
                                    var isDanger = row.cells[11].data;
                                    if (isDanger) {
                                        return gridjs.html('<span style="color:#dc2626;">' + val + '</span>');
                                    }
                                    return val;
                                }
                            },
                            {
                                name: 'Failed Relay',
                                width: '110px',
                                sort: true,
                                formatter: function(cell, row) {
                                    var val = Number(cell).toLocaleString('en-US');
                                    var isDanger = row.cells[11].data;
                                    if (isDanger) {
                                        return gridjs.html('<span style="color:#dc2626;">' + val + '</span>');
                                    }
                                    return val;
                                }
                            },
                            {
                                name: 'Successes',
                                width: '100px',
                                sort: true,
                                formatter: function(cell, row) {
                                    var val = Number(cell).toLocaleString('en-US');
                                    var isDanger = row.cells[11].data;
                                    if (isDanger) {
                                        return gridjs.html('<span style="color:#dc2626;">' + val + '</span>');
                                    }
                                    return val;
                                }
                            },
                            { name: '#', width: '50px', sort: true, formatter: fmtCell },
                            { name: 'Users', width: '160px', sort: true, formatter: fmtCell },
                            { name: 'danger', hidden: true },
                            { name: 'ipLookup', hidden: true },
                            { name: 'blocked', hidden: true }
                        ],
                        data: filteredData,
                        pagination: { limit: 15, summary: true },
                        search: { enabled: false },
                        sort: true,
                        language: {
                            'nothing found': '<div class="mui-empty"><i class="fas fa-server"></i>Nothing to see here move along.</div>'
                        },
                        className: {
                            table: 'gridjs-table',
                            thead: 'gridjs-thead',
                            th: 'gridjs-th',
                            tbody: 'gridjs-tbody',
                            td: 'gridjs-td'
                        }
                    }).render(container);
                }
                updateTotals();
            }

            function doCustomSearch() {
                var q = customSearchInput.value.toLowerCase();
                if (!q) {
                    filteredData = allData.slice();
                    filterConfig.forEach(function(fc) {
                        var sel = getSelected(fc.key);
                        if (sel.length > 0 && sel.length < getDistinct(fc.idx).length) {
                            filteredData = filteredData.filter(function(row) { return sel.indexOf(row[fc.idx]) !== -1; });
                        }
                    });
                } else {
                    filteredData = allData.filter(function(row) {
                        for (var ci = 0; ci < row.length - 3; ci++) {
                            if (String(row[ci]).toLowerCase().indexOf(q) !== -1) return true;
                        }
                        return false;
                    });
                    filterConfig.forEach(function(fc) {
                        var sel = getSelected(fc.key);
                        if (sel.length > 0 && sel.length < getDistinct(fc.idx).length) {
                            filteredData = filteredData.filter(function(row) { return sel.indexOf(row[fc.idx]) !== -1; });
                        }
                    });
                }
                renderGrid();
            }

            customSearchInput.addEventListener('input', doCustomSearch);

            document.getElementById('btn-csv').addEventListener('click', function() {
                var rows = grid ? grid.config.data : filteredData;
                var header = ['IP Address','Country','First Seen','Last Seen','Days Seen','Attempts','Failures','Failed Relay','Successes','#','Users'];
                var csv = header.join(',') + '\\n';
                rows.forEach(function(r) {
                    var vals = [r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10]];
                    var esc = vals.map(function(c) { return '"' + String(c).replace(/"/g, '""') + '"'; });
                    csv += esc.join(',') + '\\n';
                });
                var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                var link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'SMTPLog.csv';
                link.click();
                URL.revokeObjectURL(link.href);
            });

            document.getElementById('btn-copy').addEventListener('click', function() {
                var rows = grid ? grid.config.data : filteredData;
                var header = ['IP Address','Country','First Seen','Last Seen','Days Seen','Attempts','Failures','Failed Relay','Successes','#','Users'];
                var pad = [22, 14, 12, 12, 10, 10, 10, 12, 10, 6, 24];
                function fmtRow(arr) {
                    return arr.slice(0, 11).map(function(c, i) { return String(c).padEnd(pad[i] || 20).slice(0, pad[i] || 20); }).join(' | ');
                }
                var text = fmtRow(header) + '\\n' + '-'.repeat(fmtRow(header).length) + '\\n';
                text += rows.map(fmtRow).join('\\n');
                navigator.clipboard.writeText(text).then(function() {
                    var btn = document.getElementById('btn-copy');
                    var orig = btn.innerHTML;
                    btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                    setTimeout(function() { btn.innerHTML = orig; }, 2000);
                });
            });

            document.getElementById('btn-print').addEventListener('click', function() {
                var rows = grid ? grid.config.data : filteredData;
                var win = window.open('', '_blank');
                var html = '<!DOCTYPE html><html><head><title>SMTP Log</title>';
                html += '<style>body{font-family:Roboto,sans-serif;margin:20px;}';
                html += 'h2{color:#1e293b;}table{border-collapse:collapse;width:100%;font-size:12px;}';
                html += 'th{background:#1976d2;color:#fff;padding:8px 10px;text-align:left;font-size:11px;text-transform:uppercase;}';
                html += 'td{padding:6px 10px;border-bottom:1px solid #e2e8f0;}tr:nth-child(even){background:#fafafa;}';
                html += 'tfoot td{font-weight:600;background:#f8fafc;border-top:2px solid #1976d2;}</style></head><body>';
                html += '<h2>SMTP Log</h2><table><thead><tr>';
                html += '<th>IP Address</th><th>Country</th><th>First Seen</th><th>Last Seen</th><th>Days Seen</th><th>Attempts</th><th>Failures</th><th>Failed Relay</th><th>Successes</th><th>#</th><th>Users</th>';
                html += '</tr></thead><tbody>';
                rows.forEach(function(r) {
                    var danger = r[11];
                    var style = danger ? ' style="color:#dc2626;"' : '';
                    html += '<tr' + style + '><td>' + r[0] + '</td><td>' + r[1] + '</td><td>' + r[2] + '</td><td>' + r[3] + '</td><td>' + r[4] + '</td><td>' + Number(r[5]).toLocaleString('en-US') + '</td><td>' + Number(r[6]).toLocaleString('en-US') + '</td><td>' + Number(r[7]).toLocaleString('en-US') + '</td><td>' + Number(r[8]).toLocaleString('en-US') + '</td><td>' + r[9] + '</td><td>' + String(r[10]).replace(/</g, '&lt;') + '</td></tr>';
                });
                html += '</tbody></table></body></html>';
                win.document.write(html);
                win.document.close();
                win.focus();
                win.print();
            });

            document.getElementById('btn-clear-filters').addEventListener('click', clearFilters);

            filterConfig.forEach(function(fc) {
                buildMultiSelect('ms-' + fc.key, fc);
            });

            renderGrid();
        });

