            font-size: 0.85rem;
        }
        .mui-filters-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 20px;
            gap: 12px;
            flex-wrap: wrap;
        }
        .mui-filters-row .mui-filters-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .mui-filters-row .mui-filters-right {
            display: flex;
            align-items: center;
        }
        .mui-filters-row .mui-filters-right input {
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            padding: 6px 12px;
            font-family: 'Roboto', sans-serif;
            font-size: 0.8125rem;
            outline: none;
            transition: border-color 0.2s;
            width: 200px;
        }
        .mui-filters-row .mui-filters-right input:focus {
            border-color: #1976d2;
            box-shadow: 0 0 0 2px rgba(25,118,210,0.15);
        }
        .mui-multiselect {
            position: relative;
            display: inline-block;
        }
        .mui-multiselect-toggle {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 10px;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            font-family: 'Roboto', sans-serif;
            font-size: 0.8125rem;
            color: #334155;
