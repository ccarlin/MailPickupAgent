{
  "name": "mail-pickup-agent",
  "version": "1.0.0",
  "description": "A Node.js executable that acts as a mail pickup agent for MailEnable, intercepting emails and routing them to quarantine or release.",
  "main": "index.js",
  "bin": {
    "mailpickup": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "server": "node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "mail",
    "email",
    "mailenable",
    "pickup",
    "agent",
    "quarantine",
    "release"
  ],
  "author": "Chuck Carlin",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "collections": "^5.1.13",

    "express": "^5.2.1",
    "mailparser": "^3.6.4",
    "mmdb-reader": "^1.2.0",
    "moment": "^2.30.1",
    "nodemailer": "^8.0.10",
    "pug": "^3.0.4",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0"
  }
}
