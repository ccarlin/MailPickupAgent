{
  "name": "mail-pickup-agent",
  "version": "2.8.7",
  "description": "A Node.js executable that acts as a mail pickup agent for MailEnable, intercepting emails and routing them to quarantine or release.",
  "main": "index.js",
  "bin": {
    "mailpickup": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "server": "node server.js",
    "postinstall": "node install.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node index.js --test",
    "wipeall": "node index.js --wipeall",
    "purge": "node index.js --purge",
    "spamTest": "node test/testSpamAssassin.js",
    "spamTest:dev": "set NODE_ENV=development&& node test/testSpamAssassin.js",
    "aiTest": "node test/testAI.js",
    "aiTest:dev": "set NODE_ENV=development&& node test/testAI.js",
    "abuseipdbTest": "node test/testAbuseIPDB.js",
    "abuseipdbTest:dev": "set NODE_ENV=development&& node test/testAbuseIPDB.js"
  },
  "keywords": [
    "mail",
    "email",
    "mailenable",
    "pickup",
    "agent",
    "quarantine",
    "release"
  ],
  "author": "Chuck Carlin",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.0",
    "better-sqlite3": "^13.0.1",
    "better-sqlite3-session-store": "^0.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "mmdb-reader": "^1.2.0",
    "nodemailer": "^9.0.0",
    "postal-mime": "^2.7.4",
    "pug": "^3.0.4",
    "spamassassin-client": "^1.3.0",
    "web-push": "^3.6.7",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true
  }
}
