# MailPickupAgent environment variables
# Copy this file to .env and fill in the values.

# Directory for quarantined emails
QUARANTINE_DIR=./quarantine

# Directory for released emails when RELEASE_METHOD is not smtp
RELEASE_DIR=./release

# Directory for emails that have been processed and can be purged later
DELETED_DIR=./deleted

# SMTP settings for releasing email via SMTP
SMTP_HOST=localhost
SMTP_PORT=25

# Set to 'smtp' to send via SMTP; otherwise the email files are moved to RELEASE_DIR
RELEASE_METHOD=

# Rules file (JSON with whitelist and blacklist sections)
RULES_FILE=./rules.json

# Ollama AI settings for spam classification
OLLAMA_SERVER=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2

# SPAMAssassin settings for spam classification
SPAMASSASSIN_HOST=localhost
SPAMASSASSIN_PORT=783
SPAMASSASSIN_ENABLED=true

# Thresholds for spam scoring
THRESHOLD_QUARANTINE=5
THRESHOLD_DELETE=15

# Logging settings
PROCESSING_LOG=./
